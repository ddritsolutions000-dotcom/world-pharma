model SettlementImportBatch {
  id               String                      @id @db.Uuid
  countryId        String                       @map("country_id") @db.Uuid
  providerCode     String                       @map("provider_code")
  environment      String                       @default("sandbox")
  externalBatchRef String                       @map("external_batch_ref")
  idempotencyKey   String                       @unique @map("idempotency_key")
  status           SettlementImportBatchStatus  @default(RECEIVED)
  importSource     SettlementImportSource       @default(MANUAL) @map("import_source")
  currency         String                       @db.Char(3)
  recordCount      Int                          @default(0) @map("record_count")
  matchedCount     Int                          @default(0) @map("matched_count")
  errorDetail      String?                      @map("error_detail")
  transientFailure Boolean                      @default(false) @map("transient_failure")
  sandbox          Boolean                      @default(true)
  workerRunId      String?                      @map("worker_run_id") @db.Uuid
  createdBy        String?                      @map("created_by") @db.Uuid
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  processedAt      DateTime?                    @map("processed_at") @db.Timestamptz
  country          Country                      @relation(fields: [countryId], references: [id])
  workerRun        SettlementImportWorkerRun?   @relation(fields: [workerRunId], references: [id])
  records          SettlementImportRecord[]

  @@unique([providerCode, environment, externalBatchRef])
  @@index([countryId, status, createdAt])
  @@index([importSource, createdAt])
  @@map("settlement_import_batches")
}

