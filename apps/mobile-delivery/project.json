{
  "name": "mobile-delivery",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile-delivery/src",
  "projectType": "application",
  "tags": ["type:app", "scope:delivery"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/mobile-delivery/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/mobile-delivery/jest.config.cts",
        "passWithNoTests": false
      }
    }
  }
}
