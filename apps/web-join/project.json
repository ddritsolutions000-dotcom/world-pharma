{
  "name": "web-join",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-join",
  "projectType": "application",
  "tags": ["type:app", "scope:join"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @world-pharma/web-join dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/web-join",
        "env": { "NODE_ENV": "production" }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/web-join/tsconfig.json" }
    }
  }
}
