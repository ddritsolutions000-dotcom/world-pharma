{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.e2e.spec.ts",
    "src/test/jest-after-env.ts"
  ]
}
