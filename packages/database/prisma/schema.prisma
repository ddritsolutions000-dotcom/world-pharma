  action          String
  outcome         String
  reasonCategory  String?             @map("reason_category")
  requestId       String?             @map("request_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  session         VideoSession        @relation(fields: [sessionId], references: [id])
  actor           Person               @relation(fields: [actorPersonId], references: [id])

  @@index([sessionId, createdAt])
  @@index([actorPersonId, createdAt])
  @@map("video_join_audits")
}

model VideoWebhookReceipt {
  id          String   @id @db.Uuid
  provider    String
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  sessionId   String?   @map("session_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  session     VideoSession? @relation(fields: [sessionId], references: [id])

  @@index([provider, createdAt])
  @@map("video_webhook_receipts")
}

/// R5-A prescription foundation. Clinical artifact only — not an Order/Payment/Shipment.
enum PrescriptionStatus {
  DRAFT
  ISSUED
  SUPERSEDED
  CANCELLED
  EXPIRED
  FULLY_DISPENSED
}

enum PrescriptionOrigin {
  ENCOUNTER
  UPLOAD
  EXTERNAL_ERX
}

model Prescription {
  id                 String              @id @db.Uuid
  countryId          String              @map("country_id") @db.Uuid
  patientPersonId    String              @map("patient_person_id") @db.Uuid
  doctorProfileId    String              @map("doctor_profile_id") @db.Uuid
  doctorPartnerId    String              @map("doctor_partner_id") @db.Uuid
  encounterId        String              @map("encounter_id") @db.Uuid
  organizationId     String?             @map("organization_id") @db.Uuid
  status             PrescriptionStatus  @default(DRAFT)
  origin             PrescriptionOrigin  @default(ENCOUNTER)
  currentVersionId   String?             @unique @map("current_version_id") @db.Uuid
  createdByPersonId  String              @map("created_by_person_id") @db.Uuid
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  country            Country             @relation(fields: [countryId], references: [id])
  patient            Person              @relation("PrescriptionPatient", fields: [patientPersonId], references: [id])
  doctorProfile      DoctorProfile       @relation(fields: [doctorProfileId], references: [id])
  encounter          Encounter           @relation(fields: [encounterId], references: [id])
  organization       Organization?       @relation(fields: [organizationId], references: [id])
  createdBy          Person              @relation("PrescriptionCreatedBy", fields: [createdByPersonId], references: [id])
  currentVersion     PrescriptionVersion? @relation("PrescriptionCurrentVersion", fields: [currentVersionId], references: [id])
  versions           PrescriptionVersion[] @relation("PrescriptionVersions")
  statusHistory      PrescriptionStatusHistory[]
  dispensingCases    DispensingCase[]
  healthArtifacts    HealthArtifact[]
  erxSubmissions     PrescriptionErxSubmission[]

  @@index([patientPersonId, createdAt])
  @@index([doctorProfileId, createdAt])
  @@index([countryId, status])
  @@index([encounterId])
  @@map("prescriptions")
}

model PrescriptionVersion {
  id                     String    @id @db.Uuid
  prescriptionId         String    @map("prescription_id") @db.Uuid
  versionNumber          Int       @map("version_number")
  supersedesVersionId    String?   @map("supersedes_version_id") @db.Uuid
  sealedAt               DateTime? @map("sealed_at") @db.Timestamptz
  validFrom              DateTime? @map("valid_from") @db.Timestamptz
  validUntil             DateTime? @map("valid_until") @db.Timestamptz
  integritySeal          String?   @map("integrity_seal")
  createdByPersonId      String    @map("created_by_person_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz

  prescription           Prescription @relation("PrescriptionVersions", fields: [prescriptionId], references: [id])
  currentFor             Prescription? @relation("PrescriptionCurrentVersion")
  supersedes             PrescriptionVersion? @relation("PrescriptionVersionChain", fields: [supersedesVersionId], references: [id])
  supersededBy           PrescriptionVersion[] @relation("PrescriptionVersionChain")
  createdBy              Person @relation("PrescriptionVersionCreatedBy", fields: [createdByPersonId], references: [id])
  lines                  PrescriptionLine[]
  dispensingCases        DispensingCase[]
  healthArtifacts        HealthArtifact[]
  erxSubmission          PrescriptionErxSubmission?

  @@unique([prescriptionId, versionNumber])
  @@index([prescriptionId, createdAt])
  @@map("prescription_versions")
}

model PrescriptionLine {
  id                        String   @id @db.Uuid
  versionId                 String   @map("version_id") @db.Uuid
  lineNumber                Int      @map("line_number")
  clinicalConceptCode       String   @map("clinical_concept_code")
  clinicalConceptLabel      String   @map("clinical_concept_label")
  strengthText              String?  @map("strength_text")
  formText                  String?  @map("form_text")
  routeText                 String?  @map("route_text")
  dosageInstructions        String   @map("dosage_instructions")
  quantityAuthorized        String   @map("quantity_authorized")
  quantityUnit              String?  @map("quantity_unit")
  daysSupply                Int?     @map("days_supply")
  substitutionAllowed       Boolean  @default(false) @map("substitution_allowed")
  restrictionCategoryCode   String?  @map("restriction_category_code")
  /// Optional commercial hint only — not clinical truth; no dispense/allocation in R5-A.
  suggestedCatalogItemId    String?  @map("suggested_catalog_item_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz

  version                   PrescriptionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, lineNumber])
  @@index([versionId])
  @@map("prescription_lines")
}

model PrescriptionStatusHistory {
  id               String             @id @db.Uuid
  prescriptionId   String             @map("prescription_id") @db.Uuid
  fromStatus       PrescriptionStatus? @map("from_status")
  toStatus         PrescriptionStatus @map("to_status")
  actorPersonId    String?            @map("actor_person_id") @db.Uuid
  reasonCode       String?            @map("reason_code")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz

  prescription     Prescription       @relation(fields: [prescriptionId], references: [id])
  actor            Person?            @relation("PrescriptionStatusActor", fields: [actorPersonId], references: [id])

  @@index([prescriptionId, createdAt])
  @@map("prescription_status_history")
}

/// R5-F provider-neutral e-Rx submission audit — one row per sealed prescription version.
enum PrescriptionErxSubmissionStatus {
  PENDING
  SUBMITTED
  UNSUPPORTED
  FAILED
  CANCELLED
}

model PrescriptionErxSubmission {
  id                    String                        @id @db.Uuid
  prescriptionId        String                        @map("prescription_id") @db.Uuid
  prescriptionVersionId   String                        @unique @map("prescription_version_id") @db.Uuid
  countryId             String                        @map("country_id") @db.Uuid
  providerCode          String                        @map("provider_code")
  providerRef           String?                       @map("provider_ref")
  status                PrescriptionErxSubmissionStatus @default(PENDING)
  reasonCode            String?                       @map("reason_code")
  attemptCount          Int                           @default(0) @map("attempt_count")
  submittedAt           DateTime?                     @map("submitted_at") @db.Timestamptz
  cancelledAt           DateTime?                     @map("cancelled_at") @db.Timestamptz
  actorPersonId         String?                       @map("actor_person_id") @db.Uuid
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz

  prescription          Prescription                  @relation(fields: [prescriptionId], references: [id])
  prescriptionVersion   PrescriptionVersion           @relation(fields: [prescriptionVersionId], references: [id])
  country               Country                       @relation(fields: [countryId], references: [id])
  actor                 Person?                       @relation("PrescriptionErxSubmissionActor", fields: [actorPersonId], references: [id])

  @@index([prescriptionId])
  @@index([countryId, status])
  @@map("prescription_erx_submissions")
}

/// R5-C pharmacy dispensing — clinical auth workflow; not an Order.
enum DispensingCaseStatus {
  QUEUED
  VALIDATING
  REJECTED
  AUTHORIZED_TO_DISPENSE
  DISPENSING
  DISPENSED
  FAILED
  CANCELLED_CASE
  SUPERSEDED
}

enum DispenseEventKind {
  QUEUED
  CLAIMED
  VALIDATE_START
  REJECT
  AUTHORIZE
  MAP_LINES
  COMPLETE
  CANCEL_CASE
  FAIL
  SUPERSEDE
}

model DispensingCase {
  id                     String               @id @db.Uuid
  prescriptionId         String               @map("prescription_id") @db.Uuid
  prescriptionVersionId  String               @map("prescription_version_id") @db.Uuid
  countryId              String               @map("country_id") @db.Uuid
  organizationId         String?              @map("organization_id") @db.Uuid
  locationId             String?              @map("location_id") @db.Uuid
  status                 DispensingCaseStatus @default(QUEUED)
  claimedByPersonId      String?              @map("claimed_by_person_id") @db.Uuid
  rejectedReasonCode     String?              @map("rejected_reason_code")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  prescription           Prescription         @relation(fields: [prescriptionId], references: [id])
  prescriptionVersion    PrescriptionVersion  @relation(fields: [prescriptionVersionId], references: [id])
  country                Country              @relation(fields: [countryId], references: [id])
  organization           Organization?        @relation(fields: [organizationId], references: [id])
  location               Location?            @relation(fields: [locationId], references: [id])
  claimedBy              Person?              @relation("DispensingCaseClaimedBy", fields: [claimedByPersonId], references: [id])
  events                 DispenseEvent[]
  lineMappings           DispenseLineMapping[]

  @@index([status, countryId, createdAt])
  @@index([prescriptionId, status])
  @@index([prescriptionVersionId])
  @@index([organizationId, locationId, status])
  @@map("dispensing_cases")
}

model DispenseEvent {
  id               String            @id @db.Uuid
  caseId           String            @map("case_id") @db.Uuid
  kind             DispenseEventKind
  actorPersonId    String            @map("actor_person_id") @db.Uuid
  reasonCode       String?           @map("reason_code")
  idempotencyKey   String            @unique @map("idempotency_key")
  /// Non-PHI metadata only (ids, opaque codes).
  metaJson         Json?             @map("meta_json")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  case             DispensingCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor            Person            @relation("DispenseEventActor", fields: [actorPersonId], references: [id])

  @@index([caseId, createdAt])
  @@map("dispense_events")
}

/// Explicit clinical line → commercial catalog (+ lot) mapping. Never silent.
model DispenseLineMapping {
  id                   String   @id @db.Uuid
  caseId               String   @map("case_id") @db.Uuid
  prescriptionLineId   String   @map("prescription_line_id") @db.Uuid
  catalogItemId        String   @map("catalog_item_id") @db.Uuid
  catalogVariantId     String   @map("catalog_variant_id") @db.Uuid
  inventoryLotId       String?  @map("inventory_lot_id") @db.Uuid
  quantityDispensed    String   @map("quantity_dispensed")
  confirmSubstitution  Boolean  @default(false) @map("confirm_substitution")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  case                 DispensingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, prescriptionLineId])
  @@index([caseId])
  @@map("dispense_line_mappings")
}

/// R5-E refill request (ED-R5E-01 fail-closed + request/re-auth). Never mutates sealed Rx versions or old Orders.
enum RefillRequestStatus {
  REQUESTED
  PENDING_REAUTH
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED_BLOCKED
  QUEUED_FOR_DISPENSE
}

model RefillRequest {
  id                      String              @id @db.Uuid
  prescriptionId          String              @map("prescription_id") @db.Uuid
  prescriptionVersionId   String              @map("prescription_version_id") @db.Uuid
  customerPersonId        String              @map("customer_person_id") @db.Uuid
  countryId               String              @map("country_id") @db.Uuid
  status                  RefillRequestStatus @default(REQUESTED)
  /// Opaque eligibility / denial reason code (non-PHI).
  eligibilityReasonCode   String?             @map("eligibility_reason_code")
  /// Non-PHI decision codes only (ids, pack flags).
  eligibilitySnapshot     Json?               @map("eligibility_snapshot")
  decidedByPersonId       String?             @map("decided_by_person_id") @db.Uuid
  decisionReasonCode      String?             @map("decision_reason_code")
  decidedAt               DateTime?           @map("decided_at") @db.Timestamptz
  dispensingCaseId        String?             @map("dispensing_case_id") @db.Uuid
  idempotencyKey          String              @unique @map("idempotency_key")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  customer                Person              @relation("RefillRequestCustomer", fields: [customerPersonId], references: [id])
  decider                 Person?             @relation("RefillRequestDecider", fields: [decidedByPersonId], references: [id])
  history                 RefillRequestHistory[]

  @@index([customerPersonId, createdAt])
  @@index([prescriptionId, status])
  @@index([countryId, status])
  @@map("refill_requests")
}

model RefillRequestHistory {
  id             String              @id @db.Uuid
  requestId      String              @map("request_id") @db.Uuid
  fromStatus     RefillRequestStatus @map("from_status")
  toStatus       RefillRequestStatus @map("to_status")
  actorPersonId  String              @map("actor_person_id") @db.Uuid
  reasonCode     String?             @map("reason_code")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  request        RefillRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor          Person              @relation("RefillHistoryActor", fields: [actorPersonId], references: [id])

  @@index([requestId, createdAt])
  @@map("refill_request_history")
}

/// Gated subscription foundation. auto_execute defaults false; recurring payment/dispense OFF unless pack + flag.
enum RxSubscriptionStatus {
  DISABLED
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED_BLOCKED
  PAYMENT_FAILED
}

model RxSubscription {
  id                   String               @id @db.Uuid
  prescriptionId       String               @map("prescription_id") @db.Uuid
  customerPersonId     String               @map("customer_person_id") @db.Uuid
  countryId            String               @map("country_id") @db.Uuid
  status               RxSubscriptionStatus @default(DISABLED)
  /// Hard default false — automatic recurring execution must stay OFF (ED-R5E-01 / Book 119).
  autoExecuteEnabled   Boolean              @default(false) @map("auto_execute_enabled")
  nextAttemptAt        DateTime?            @map("next_attempt_at") @db.Timestamptz
  lastAttemptAt        DateTime?            @map("last_attempt_at") @db.Timestamptz
  pauseReasonCode      String?              @map("pause_reason_code")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  customer             Person               @relation(fields: [customerPersonId], references: [id])

  @@unique([prescriptionId, customerPersonId])
  @@index([customerPersonId, status])
  @@index([countryId, status])
  @@map("rx_subscriptions")
}

/// R7-B: customer diagnostics booking (commercial spine). Not Appointment. Not Sample/CoC.
enum LabCollectionMode {
  HOME
  CENTER
}

enum LabBookingStatus {
  BOOKED
  CONFIRMED
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
}

model LabBooking {
  id                 String             @id @db.Uuid
  countryId          String             @map("country_id") @db.Uuid
  customerPersonId   String             @map("customer_person_id") @db.Uuid
  labOrgId           String             @map("lab_org_id") @db.Uuid
  /// CENTER mode: must belong to labOrgId and LocationKind.LAB (server-validated).
  labLocationId      String?            @map("lab_location_id") @db.Uuid
  collectionMode     LabCollectionMode  @map("collection_mode")
  status             LabBookingStatus   @default(BOOKED)
  currency           String             @db.Char(3)
  totalMinor         BigInt             @map("total_minor")
  slotStartsAt       DateTime?          @map("slot_starts_at") @db.Timestamptz
  slotEndsAt         DateTime?          @map("slot_ends_at") @db.Timestamptz
  timezone           String?
  customerAddressId  String?            @map("customer_address_id") @db.Uuid
  addressSnapshot    Json?              @map("address_snapshot")
  paymentIntentId    String?            @map("payment_intent_id") @db.Uuid
  idempotencyKey     String             @unique @map("idempotency_key")
  sandbox            Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  country            Country            @relation(fields: [countryId], references: [id])
  customer           Person             @relation(fields: [customerPersonId], references: [id])
  labOrg             Organization       @relation(fields: [labOrgId], references: [id])
  labLocation        Location?          @relation(fields: [labLocationId], references: [id])
  customerAddress    CustomerAddress?   @relation(fields: [customerAddressId], references: [id])
  lines              LabBookingLine[]
  history            LabBookingStatusHistory[]
  paymentIntents     PaymentIntent[]
  sample             LabSample?
  labReport          LabReport?
  healthArtifacts    HealthArtifact[]
  physicalReportRequest PhysicalReportRequest?

  @@index([customerPersonId, status])
  @@index([labOrgId, status])
  @@index([countryId, status])
  @@index([labLocationId])
  @@map("lab_bookings")
}

model LabBookingLine {
  id            String     @id @db.Uuid
  labBookingId  String     @map("lab_booking_id") @db.Uuid
  offerId       String     @map("offer_id") @db.Uuid
  variantId     String     @map("variant_id") @db.Uuid
  title         String
  qty           Int        @default(1)
  unitMinor     BigInt     @map("unit_minor")
  lineMinor     BigInt     @map("line_minor")
  currency      String     @db.Char(3)
  priceVersion  Int?       @map("price_version")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz

  booking       LabBooking @relation(fields: [labBookingId], references: [id], onDelete: Cascade)
  offer         CatalogOffer @relation(fields: [offerId], references: [id])
  variant       CatalogVariant @relation(fields: [variantId], references: [id])

  @@index([labBookingId])
  @@index([offerId])
  @@map("lab_booking_lines")
}

model LabBookingStatusHistory {
  id            String           @id @db.Uuid
  labBookingId  String           @map("lab_booking_id") @db.Uuid
  fromStatus    LabBookingStatus @map("from_status")
  toStatus      LabBookingStatus @map("to_status")
  actorPersonId String           @map("actor_person_id") @db.Uuid
  reasonCode    String?          @map("reason_code")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  booking       LabBooking       @relation(fields: [labBookingId], references: [id], onDelete: Cascade)
  actor         Person           @relation(fields: [actorPersonId], references: [id])

  @@index([labBookingId, createdAt])
  @@map("lab_booking_status_history")
}

/// R7-C/D: diagnostics sample + append-only chain of custody (through PROCESSING). Not pathology.
enum LabSampleCocStatus {
  ASSIGNED
  ACCEPTED
  ARRIVED
  VERIFIED
  COLLECTED
  SEALED
  HANDED_OVER
  IN_TRANSIT
  LAB_RECEIVED
  ACCEPTED_BY_LAB
  PROCESSING
  REJECTED
  DAMAGED
  LOST
  TEMPERATURE_EXCEPTION
  INSUFFICIENT_SAMPLE
  WRONG_SAMPLE
  RECOLLECTION_REQUIRED
}

enum LabProcessingStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  ON_HOLD
}

model LabSample {
