{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "esnext",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@world-pharma/config": ["packages/config/src/index.ts"],
      "@world-pharma/database": ["packages/database/src/index.ts"],
      "@world-pharma/shared": ["packages/shared/src/index.ts"],
      "@world-pharma/shared/site-chrome": ["packages/shared/src/site-chrome.ts"],
      "@world-pharma/shared/site-page-blocks": ["packages/shared/src/site-page-blocks.ts"],
      "@world-pharma/shared/join-page-blocks": ["packages/shared/src/join-page-blocks.ts"],
      "@world-pharma/shared/partner-fields": ["packages/shared/src/partner-fields.ts"],
      "@world-pharma/ui-kit": ["packages/ui-kit/src/index.ts"],
      "@world-pharma/ui-kit/tokens": ["packages/ui-kit/src/tokens/index.ts"],
      "@world-pharma/ui-kit/web": ["packages/ui-kit/src/web/index.ts"],
      "@world-pharma/ui-kit/native": ["packages/ui-kit/src/native/index.ts"],
      "@world-pharma/shell-core": ["packages/shell-core/src/index.ts"],
      "@world-pharma/shell-web": ["packages/shell-web/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
