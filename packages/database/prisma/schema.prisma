// Phase 1E order + fulfillment foundation. No DHL / settlement / live PSP.

enum OrderStatus {
  CONFIRMED
  ON_HOLD
  ALLOCATED
  PICKING
  PICKED
  PACKING
  PACKED
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCEL_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum FulfillmentStatus {
  ALLOCATED
  PICKING
  PICKED
  PACKING
  PACKED
  READY_TO_SHIP
  CANCELLED
}

enum PickTaskStatus {
  OPEN
  IN_PROGRESS
  PICKED
  EXCEPTION
}

enum PackTaskStatus {
  OPEN
  IN_PROGRESS
  PACKED
  EXCEPTION
}

enum ShipmentStatus {
  DRAFT
  READY
  BOOKING
  BOOKED
  LABEL_CREATED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  BOOKING_FAILED
  BOOKING_UNKNOWN
  CANCEL_REQUESTED
  CANCELLED
  DELIVERY_FAILED
  RETURN_TO_ORIGIN
  RETURNED
  LOST
  DAMAGED
  HANDOFF_PENDING
}

enum LogisticsJobType {
  MEDICINE_DELIVERY
  SAMPLE_COLLECTION
  SAMPLE_TRANSPORT
  REPORT_DELIVERY
}

enum ShippingServiceLevel {
  STANDARD
  EXPRESS
  SAME_DAY
  NEXT_DAY
  ECONOMY
  INTERNATIONAL
}

enum TemperatureRequirement {
  AMBIENT
  REFRIGERATED
  FROZEN
  TEMPERATURE_MONITORED
}

enum ProofOfDeliveryKind {
  OTP
  SIGNATURE
  PHOTO
}

enum ReturnDisposition {
  QUARANTINE
  INSPECT
  RESTOCK
  DESTROY
}

enum CarrierReconStatus {
  MATCHED
  BREAK
  INVESTIGATE
}

enum ReturnReason {
  WRONG_ITEM
  DAMAGED
  DELIVERY_FAILURE
  CUSTOMER_REFUSAL
  OTHER_POLICY_ALLOWED
}

model Order {
  id                 String   @id @db.Uuid
  orderNumber        String    @unique @map("order_number")
  customerPersonId   String    @map("customer_person_id") @db.Uuid
  sellerOrgId        String    @map("seller_org_id") @db.Uuid
  countryId          String    @map("country_id") @db.Uuid
  legalEntityId      String?   @map("legal_entity_id") @db.Uuid
  checkoutSessionId String    @map("checkout_session_id") @db.Uuid
  checkoutQuoteId   String    @map("checkout_quote_id") @db.Uuid
  paymentIntentId    String    @unique @map("payment_intent_id") @db.Uuid
  fulfillingLocationId String @map("fulfilling_location_id") @db.Uuid
  /// R5-D linkage (optional). One Order per dispense_event when set.
  dispensingCaseId   String?  @map("dispensing_case_id") @db.Uuid
  dispenseEventId    String?  @unique @map("dispense_event_id") @db.Uuid
  prescriptionId     String?  @map("prescription_id") @db.Uuid
  prescriptionVersionId String? @map("prescription_version_id") @db.Uuid
  /// True when ED-R5D-01 Option B: inventory already consumed at R5-C complete.
  rxInventoryConsumedAtDispense Boolean @default(false) @map("rx_inventory_consumed_at_dispense")
  status             OrderStatus @default(CONFIRMED)
  currency            String    @db.Char(3)
  goodsMinor         BigInt   @map("goods_minor")
  discountMinor      BigInt   @default(0) @map("discount_minor")
  taxMinor           BigInt   @default(0) @map("tax_minor")
  shippingMinor      BigInt   @default(0) @map("shipping_minor")
  totalMinor         BigInt   @map("total_minor")
  sandbox            Boolean  @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customer           Person   @relation(fields: [customerPersonId], references: [id])
  sellerOrg          Organization @relation(fields: [sellerOrgId], references: [id])
  country            Country  @relation(fields: [countryId], references: [id])
  legalEntity        LegalEntity? @relation(fields: [legalEntityId], references: [id])
  checkoutSession    CheckoutSession @relation(fields: [checkoutSessionId], references: [id])
  checkoutQuote      CheckoutQuote @relation(fields: [checkoutQuoteId], references: [id])
  paymentIntent      PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  fulfillingLocation Location @relation(fields: [fulfillingLocationId], references: [id])
  items              OrderItem[]
  address            OrderAddressSnapshot?
  pricing            OrderPricingSnapshot?
  tax                OrderTaxSnapshot?
  promo              OrderPromoSnapshot?
  affiliate          OrderAffiliateSnapshot?
  shipping           OrderShippingSnapshot?
  payment            OrderPaymentSnapshot?
  economics          OrderEconomicsSnapshot?
  history            OrderStatusHistory[]
  notes              OrderNote[]
  fulfillmentGroups FulfillmentGroup[]
  shipments          Shipment[]
  returnRequests     ReturnRequest[]
  financialFacts     FinancialFact[]
  vendorPayable      VendorPayable?
  affiliateLiability AffiliateLiability?
  contribution       ContributionSnapshot?
  rxHandoffs         RxCommerceHandoff[]
  productReviews     ProductReview[]

  @@index([customerPersonId, createdAt])
  @@index([sellerOrgId, status, createdAt])
  @@index([countryId, status])
  @@index([checkoutSessionId])
  @@index([dispensingCaseId])
  @@index([prescriptionId])
  @@map("orders")
}

/// R5-D patient-driven handoff idempotency (Book 117 §6.2).
model RxCommerceHandoff {
  id                  String   @id @db.Uuid
  handoffKey          String   @unique @map("handoff_key")
  customerPersonId    String   @map("customer_person_id") @db.Uuid
  countryId           String   @map("country_id") @db.Uuid
  dispensingCaseId    String   @map("dispensing_case_id") @db.Uuid
  dispenseEventId     String   @unique @map("dispense_event_id") @db.Uuid
  prescriptionId      String   @map("prescription_id") @db.Uuid
  prescriptionVersionId String @map("prescription_version_id") @db.Uuid
  cartId              String?  @map("cart_id") @db.Uuid
  orderId             String?  @map("order_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer            Person   @relation(fields: [customerPersonId], references: [id])
  order               Order?   @relation(fields: [orderId], references: [id])

  @@index([customerPersonId, createdAt])
  @@index([dispensingCaseId])
  @@map("rx_commerce_handoffs")
}

model OrderItem {
