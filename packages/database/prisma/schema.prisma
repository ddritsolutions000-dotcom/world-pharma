  countryId     String          @map("country_id") @db.Uuid
  locationId    String?        @map("location_id") @db.Uuid
  ownership     OfferOwnership
  status        OfferStatus    @default(DRAFT)
  currency      String         @db.Char(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  publishedAt   DateTime?      @map("published_at") @db.Timestamptz

  variant       CatalogVariant @relation(fields: [variantId], references: [id])
  sellerOrg     Organization    @relation(fields: [sellerOrgId], references: [id])
  country       Country        @relation(fields: [countryId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id])
  prices        PriceVersion[]
  cartItems     CartItem[]
  labBookingLines LabBookingLine[]
  imagingBookingLines ImagingBookingLine[]
  wishlistItems WishlistItem[]

  @@unique([variantId, sellerOrgId, countryId])
  @@index([countryId, status, sellerOrgId])
  @@index([sellerOrgId, status])
  @@map("catalog_offers")
}

model PriceVersion {
  id           String   @id @db.Uuid
  offerId      String    @map("offer_id") @db.Uuid
  version       Int
  currency     String   @db.Char(3)
  costMinor    BigInt    @map("cost_minor")
  listMinor    BigInt?   @map("list_minor")
  sellMinor    BigInt    @map("sell_minor")
  validFrom    DateTime  @map("valid_from") @db.Timestamptz
  validTo      DateTime? @map("valid_to") @db.Timestamptz
  isCurrent    Boolean    @default(true) @map("is_current")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  offer        CatalogOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, version])
  @@index([offerId, isCurrent, validFrom])
  @@map("price_versions")
}

model CommercialRule {
  id            String             @id @db.Uuid
  countryId     String?            @map("country_id") @db.Uuid
  sellerOrgId   String?            @map("seller_org_id") @db.Uuid
  categoryId    String?            @map("category_id") @db.Uuid
  itemId        String?            @map("item_id") @db.Uuid
  variantId     String?            @map("variant_id") @db.Uuid
  channel       CommercialChannel?
  takeBps       Int                @default(0) @map("take_bps")
  takeFlatMinor BigInt             @default(0) @map("take_flat_minor")
  priority      Int                @default(0)
  validFrom     DateTime           @map("valid_from") @db.Timestamptz
  validTo       DateTime?          @map("valid_to") @db.Timestamptz
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  country       Country?           @relation(fields: [countryId], references: [id])
  sellerOrg     Organization?     @relation(fields: [sellerOrgId], references: [id])
  category      CatalogCategory?  @relation(fields: [categoryId], references: [id])
  item          CatalogItem?      @relation(fields: [itemId], references: [id])
  variant       CatalogVariant?   @relation(fields: [variantId], references: [id])

  @@index([countryId, sellerOrgId, validFrom])
  @@map("commercial_rules")
}

model CatalogSearchDocument {
  id            String   @id @db.Uuid
  itemId        String    @map("item_id") @db.Uuid
  countryId     String    @map("country_id") @db.Uuid
  locale        String
  title         String
  body          String   @default("")
  skuCodes      String    @default("") @map("sku_codes")
  brandName     String    @default("") @map("brand_name")
  categoryName  String    @default("") @map("category_name")
  published     Boolean   @default(false)
  inStock       Boolean   @default(false) @map("in_stock")
  version       Int       @default(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  country       Country   @relation(fields: [countryId], references: [id])

  @@unique([itemId, countryId, locale])
  @@index([countryId, published])
  @@map("catalog_search_documents")
}

// Phase 1B inventory + warehouse foundation. Additive. No cart/order/payment.

enum InventoryLotStatus {
  ACTIVE
  QUARANTINE
  EXPIRED
  CLOSED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  TRANSFER_OUT
  TRANSFER_IN
  DAMAGE
  EXPIRY
  QUARANTINE
  UNQUARANTINE
  RETURN
  PICK
  PACK
  SHIP
}

enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  POSTED
  CANCELLED
}

enum StockTransferStatus {
  DRAFT
  RESERVED
  DISPATCHED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum InventoryReservationStatus {
  OPEN
  RELEASED
  EXPIRED
  CONSUMED
}

enum InventoryReservationPurpose {
  MANUAL
  CHECKOUT
}

enum InventoryRejectDisposition {
  QUARANTINE
  DAMAGE
}

model WarehouseProfile {
  id                   String   @id @db.Uuid
  locationId           String   @unique @map("location_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  timezone             String
  fulfillmentCapable   Boolean  @default(false) @map("fulfillment_capable")
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz
  location             Location @relation(fields: [locationId], references: [id])
  organization         Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("warehouse_profiles")
}

model InventoryLot {
  id             String             @id @db.Uuid
  variantId      String              @map("variant_id") @db.Uuid
  locationId     String              @map("location_id") @db.Uuid
  ownerOrgId     String              @map("owner_org_id") @db.Uuid
  countryId      String              @map("country_id") @db.Uuid
  lotCode        String              @default("") @map("lot_code")
  expiresOn      DateTime?          @map("expires_on") @db.Date
  manufacturedOn DateTime?         @map("manufactured_on") @db.Date
  status         InventoryLotStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  variant        CatalogVariant     @relation(fields: [variantId], references: [id])
  location       Location            @relation(fields: [locationId], references: [id])
  ownerOrg       Organization        @relation(fields: [ownerOrgId], references: [id])
  country        Country            @relation(fields: [countryId], references: [id])
  balance        InventoryBalance?
  movements      InventoryMovement[]
  reservations  InventoryReservation[]
  transferLines  StockTransferLine[]
  receiptLines   GoodsReceiptLine[]

  @@unique([locationId, variantId, lotCode])
  @@index([locationId, variantId])
  @@index([ownerOrgId, countryId])
  @@index([expiresOn])
  @@map("inventory_lots")
}

model InventoryBalance {
  id          String       @id @db.Uuid
  lotId       String        @unique @map("lot_id") @db.Uuid
  onHand      Int          @default(0) @map("on_hand")
  reserved    Int          @default(0)
  damaged     Int          @default(0)
  expired     Int          @default(0)
  quarantined Int          @default(0)
  returned    Int          @default(0)
  inTransit   Int          @default(0) @map("in_transit")
  available   Int          @default(0)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  lot         InventoryLot @relation(fields: [lotId], references: [id])

  @@map("inventory_balances")
}

model InventoryMovement {
  id             String                @id @db.Uuid
  lotId          String                 @map("lot_id") @db.Uuid
  type           InventoryMovementType
  qty            Int
  reasonCode     String                 @map("reason_code")
  actorPersonId  String?                @map("actor_person_id") @db.Uuid
  idempotencyKey String                 @unique @map("idempotency_key")
  correlationId String?                @map("correlation_id")
  refType        String?                @map("ref_type")
  refId          String?                @map("ref_id") @db.Uuid
  occurredAt     DateTime              @default(now()) @map("occurred_at") @db.Timestamptz
  lot            InventoryLot           @relation(fields: [lotId], references: [id])

  @@index([lotId, occurredAt])
  @@index([refType, refId])
  @@map("inventory_movements")
}

model InventoryReservation {
  id             String                      @id @db.Uuid
  variantId      String                       @map("variant_id") @db.Uuid
  lotId          String?                     @map("lot_id") @db.Uuid
  locationId     String                       @map("location_id") @db.Uuid
  ownerOrgId     String                       @map("owner_org_id") @db.Uuid
  qty            Int
  status         InventoryReservationStatus  @default(OPEN)
  purpose        InventoryReservationPurpose   @default(MANUAL)
  expiresAt      DateTime                     @map("expires_at") @db.Timestamptz
  idempotencyKey String                       @unique @map("idempotency_key")
  transferId     String?                     @map("transfer_id") @db.Uuid
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  variant        CatalogVariant               @relation(fields: [variantId], references: [id])
  lot            InventoryLot?                 @relation(fields: [lotId], references: [id])
  location       Location                     @relation(fields: [locationId], references: [id])
  ownerOrg       Organization                 @relation(fields: [ownerOrgId], references: [id])
  transfer       StockTransfer?              @relation(fields: [transferId], references: [id])

  @@index([status, expiresAt])
  @@index([ownerOrgId, locationId, variantId])
  @@map("inventory_reservations")
}

model GoodsReceipt {
  id             String             @id @db.Uuid
  locationId     String             @map("location_id") @db.Uuid
  ownerOrgId     String             @map("owner_org_id") @db.Uuid
  countryId      String             @map("country_id") @db.Uuid
  status         GoodsReceiptStatus @default(DRAFT)
  actorPersonId  String?            @map("actor_person_id") @db.Uuid
  receivedAt     DateTime?        @map("received_at") @db.Timestamptz
  postedAt       DateTime?        @map("posted_at") @db.Timestamptz
  idempotencyKey String             @unique @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  location       Location           @relation(fields: [locationId], references: [id])
  ownerOrg       Organization        @relation(fields: [ownerOrgId], references: [id])
  country        Country           @relation(fields: [countryId], references: [id])
  lines          GoodsReceiptLine[]

  @@index([ownerOrgId, status])
  @@index([locationId, status])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                 String                      @id @db.Uuid
  receiptId          String                       @map("receipt_id") @db.Uuid
  variantId          String                       @map("variant_id") @db.Uuid
  lotCode            String                       @default("") @map("lot_code")
  expiresOn          DateTime?                   @map("expires_on") @db.Date
  manufacturedOn     DateTime?                   @map("manufactured_on") @db.Date
  qty                Int
  qtyAccepted        Int                         @default(0) @map("qty_accepted")
  qtyRejected        Int                         @default(0) @map("qty_rejected")
  rejectDisposition InventoryRejectDisposition? @map("reject_disposition")
  lotId              String?                     @map("lot_id") @db.Uuid
  receipt            GoodsReceipt                @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lot                InventoryLot?              @relation(fields: [lotId], references: [id])

  @@index([receiptId])
  @@map("goods_receipt_lines")
}

model StockTransfer {
  id             String             @id @db.Uuid
  fromLocationId String             @map("from_location_id") @db.Uuid
  toLocationId   String             @map("to_location_id") @db.Uuid
  ownerOrgId     String             @map("owner_org_id") @db.Uuid
  countryId      String             @map("country_id") @db.Uuid
  status         StockTransferStatus @default(DRAFT)
  actorPersonId  String?            @map("actor_person_id") @db.Uuid
  idempotencyKey String             @unique @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  fromLocation   Location           @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation     Location           @relation("TransferTo", fields: [toLocationId], references: [id])
  ownerOrg       Organization        @relation(fields: [ownerOrgId], references: [id])
  country        Country           @relation(fields: [countryId], references: [id])
  lines          StockTransferLine[]
  reservations   InventoryReservation[]

  @@index([ownerOrgId, status])
  @@index([countryId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id           String        @id @db.Uuid
  transferId   String         @map("transfer_id") @db.Uuid
  variantId    String         @map("variant_id") @db.Uuid
  sourceLotId  String        @map("source_lot_id") @db.Uuid
  destLotId    String?       @map("dest_lot_id") @db.Uuid
  qty          Int
  qtyInTransit Int           @default(0) @map("qty_in_transit")
  qtyReceived  Int           @default(0) @map("qty_received")
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sourceLot    InventoryLot   @relation(fields: [sourceLotId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_lines")
}

// Phase 1C cart + checkout. Additive. No Order / payment capture.

enum CartStatus {
  ACTIVE
  ABANDONED
  EXPIRED
}

enum CheckoutStatus {
  VALIDATING
  QUOTED
  REVALIDATION_REQUIRED
  READY_FOR_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  FAILED
}

enum PromoKind {
  PERCENT
  FIXED
}

enum PromoCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum PromoFunding {
  PLATFORM
  VENDOR
  SPLIT
}

enum ShippingQuoteStatus {
  UNAVAILABLE
  QUOTED
}

enum TaxQuoteStatus {
  UNKNOWN
  QUOTED
}

model Cart {
  id                String    @id @db.Uuid
  customerPersonId  String     @map("customer_person_id") @db.Uuid
  countryId         String     @map("country_id") @db.Uuid
  sellerOrgId       String?    @map("seller_org_id") @db.Uuid
  currency          String?    @db.Char(3)
  status            CartStatus @default(ACTIVE)
  /// R5-D ED-R5D-01 Option B: when set, quote skips soft reserve (stock already consumed at dispense).
  skipInventoryHold Boolean   @default(false) @map("skip_inventory_hold")
  dispensingCaseId  String?   @map("dispensing_case_id") @db.Uuid
  dispenseEventId   String?   @map("dispense_event_id") @db.Uuid
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customer          Person     @relation(fields: [customerPersonId], references: [id])
  country           Country     @relation(fields: [countryId], references: [id])
  sellerOrg         Organization? @relation(fields: [sellerOrgId], references: [id])
  items             CartItem[]
  quotes            CartQuote[]
  checkoutSessions  CheckoutSession[]

  @@unique([customerPersonId, countryId])
  @@index([countryId, status])
  @@index([dispensingCaseId])
  @@map("carts")
}

model CartItem {
  id                   String    @id @db.Uuid
  cartId               String     @map("cart_id") @db.Uuid
  offerId              String     @map("offer_id") @db.Uuid
  variantId            String     @map("variant_id") @db.Uuid
  qty                  Int
  prescriptionCaseId  String?    @map("prescription_case_id") @db.Uuid
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  cart                 Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer                CatalogOffer @relation(fields: [offerId], references: [id])
  variant              CatalogVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, offerId])
  @@index([cartId, deletedAt])
  @@map("cart_items")
}

model CartQuote {
  id          String   @id @db.Uuid
  cartId      String    @map("cart_id") @db.Uuid
  fingerprint String
  currency    String    @db.Char(3)
  sellMinor   BigInt    @map("sell_minor")
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId, createdAt])
  @@map("cart_quotes")
}

model CustomerAddress {
  id               String   @id @db.Uuid
  customerPersonId String    @map("customer_person_id") @db.Uuid
  countryId        String    @map("country_id") @db.Uuid
  recipientName    String    @map("recipient_name")
  phone            String?
  region           String?
  city             String
  postalCode       String?   @map("postal_code")
  line1            String     @map("line1")
  line2            String?
  isDefault        Boolean   @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer         Person    @relation(fields: [customerPersonId], references: [id])
  country          Country   @relation(fields: [countryId], references: [id])
  checkoutSessions CheckoutSession[]
  labBookings      LabBooking[]
  imagingPhysicalReportRequests ImagingPhysicalReportRequest[]

  @@index([customerPersonId, countryId])
  @@map("customer_addresses")
}

model CheckoutSession {
  id               String          @id @db.Uuid
  customerPersonId String           @map("customer_person_id") @db.Uuid
  countryId        String           @map("country_id") @db.Uuid
  cartId           String            @map("cart_id") @db.Uuid
  sellerOrgId      String            @map("seller_org_id") @db.Uuid
  addressId        String?          @map("address_id") @db.Uuid
  status           CheckoutStatus  @default(VALIDATING)
  idempotencyKey   String            @unique @map("idempotency_key")
  promoCode        String?         @map("promo_code")
  affiliateCode    String?         @map("affiliate_code")
  reservationIds  String[]         @default([]) @map("reservation_ids")
  /// R5-D: copy from cart — skip soft reserve + Order PICK (ED-R5D-01 Option B).
  skipInventoryHold Boolean        @default(false) @map("skip_inventory_hold")
  dispensingCaseId  String?        @map("dispensing_case_id") @db.Uuid
  dispenseEventId   String?        @map("dispense_event_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz
  correlationId   String?         @map("correlation_id")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  customer         Person           @relation(fields: [customerPersonId], references: [id])
  country          Country           @relation(fields: [countryId], references: [id])
  cart             Cart             @relation(fields: [cartId], references: [id])
  address          CustomerAddress? @relation(fields: [addressId], references: [id])
  quotes           CheckoutQuote[]
  promoApplications PromoApplication[]
  affiliateSnapshot AffiliateAttributionSnapshot?
  paymentIntents    PaymentIntent[]
  orders            Order[]

  @@index([customerPersonId, status])
  @@index([cartId, status])
  @@index([dispenseEventId])
  @@map("checkout_sessions")
}

model CheckoutQuote {
  id                String              @id @db.Uuid
  sessionId         String               @map("session_id") @db.Uuid
  fingerprint       String
  currency          String               @db.Char(3)
  sellMinor         BigInt               @map("sell_minor")
  discountMinor     BigInt               @default(0) @map("discount_minor")
  taxMinor          BigInt               @default(0) @map("tax_minor")
  shippingMinor     BigInt               @default(0) @map("shipping_minor")
  totalMinor        BigInt               @map("total_minor")
  taxStatus         TaxQuoteStatus      @default(UNKNOWN) @map("tax_status")
  shippingStatus    ShippingQuoteStatus  @default(UNAVAILABLE) @map("shipping_status")
  payload           Json
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  session           CheckoutSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  paymentIntents    PaymentIntent[]
  orders            Order[]

  @@index([sessionId, createdAt])
  @@map("checkout_quotes")
}

model PromoCampaign {
  id                String               @id @db.Uuid
  code              String               @unique
  kind              PromoKind
  percentBps        Int                  @default(0) @map("percent_bps")
  fixedMinor        BigInt               @default(0) @map("fixed_minor")
  minBasketMinor    BigInt               @default(0) @map("min_basket_minor")
  funding           PromoFunding         @default(PLATFORM)
  countryId         String?              @map("country_id") @db.Uuid
  status            PromoCampaignStatus  @default(DRAFT)
  maxRedemptions    Int?                 @map("max_redemptions")
  redeemedCount     Int                  @default(0) @map("redeemed_count")
  expiresAt         DateTime?            @map("expires_at") @db.Timestamptz
  version           Int                  @default(1)
  createdByPersonId String?              @map("created_by_person_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  country           Country?             @relation(fields: [countryId], references: [id])
  createdBy         Person?              @relation("PromoCampaignCreator", fields: [createdByPersonId], references: [id])
  applications      PromoApplication[]

  @@index([countryId, status])
  @@map("promo_campaigns")
}

model PromoApplication {
  id          String          @id @db.Uuid
  sessionId   String           @map("session_id") @db.Uuid
  campaignId  String           @map("campaign_id") @db.Uuid
  discountMinor BigInt       @map("discount_minor")
  funding     PromoFunding
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  session     CheckoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  campaign    PromoCampaign   @relation(fields: [campaignId], references: [id])

  @@index([sessionId])
  @@map("promo_applications")
}

model AffiliateAttributionSnapshot {
  id              String          @id @db.Uuid
  sessionId       String          @unique @map("session_id") @db.Uuid
  affiliateCode   String           @map("affiliate_code")
  previewMinor    BigInt         @default(0) @map("preview_minor")
  clinicalBlocked Boolean        @default(true) @map("clinical_blocked")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  session         CheckoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("affiliate_attribution_snapshots")
}

model IdempotencyRecord {
  id         String   @id @db.Uuid
  personId   String    @map("person_id") @db.Uuid
  key        String
  method     String
  path       String
  statusCode Int      @map("status_code")
  body       Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  person     Person   @relation(fields: [personId], references: [id])

  @@unique([personId, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

// Phase 1D sandbox payment kernel. No Order / live PSP / settlement.

enum PaymentIntentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  AUTHORIZED
  AUTHORIZED_COD
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
  UNKNOWN
}

enum PaymentAttemptStatus {
  CREATED
  SUBMITTED
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  REFUNDED
  FAILED
}

enum PaymentMethodFamily {
  CARD
  BANK_TRANSFER
  LOCAL_BANK
  WALLET
  MOBILE_PAYMENT
  COD
}

enum ReconciliationStatus {
  MATCHED
  BREAK
  INVESTIGATE
}

model PaymentGateway {
  id           String   @id @db.Uuid
  code         String    @unique
  name         String
  environment  String    @default("sandbox")
  active       Boolean   @default(true)
  priority     Int       @default(100)
  healthScore  Int       @default(100) @map("health_score")
  secretRef    String    @map("secret_ref")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  accounts     PaymentGatewayAccount[]
  capabilities PaymentGatewayCapability[]
  attempts     PaymentAttempt[]
  webhooks     PaymentWebhookEvent[]

  @@map("payment_gateways")
}

model PaymentGatewayAccount {
  id             String   @id @db.Uuid
  gatewayId      String    @map("gateway_id") @db.Uuid
  code           String    @unique
  countriesCsv   String     @default("*") @map("countries_csv")
  currenciesCsv  String     @default("*") @map("currencies_csv")
  methodsCsv     String     @default("CARD") @map("methods_csv")
  countryId      String?    @map("country_id") @db.Uuid
  legalEntityId  String?    @map("legal_entity_id") @db.Uuid
  active         Boolean   @default(true)
  environment    String    @default("sandbox")
  secretRef      String    @map("secret_ref")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  gateway        PaymentGateway @relation(fields: [gatewayId], references: [id])
  country        Country?  @relation(fields: [countryId], references: [id])
  legalEntity    LegalEntity? @relation(fields: [legalEntityId], references: [id])

  @@index([countryId, active])
  @@index([legalEntityId, active])
  @@map("payment_gateway_accounts")
}

model PaymentGatewayCapability {
  id         String @id @db.Uuid
  gatewayId  String  @map("gateway_id") @db.Uuid
  name       String
  enabled    Boolean @default(true)
  gateway    PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@unique([gatewayId, name])
  @@map("payment_gateway_capabilities")
}

model PaymentMethod {
  id          String               @id @db.Uuid
  family      PaymentMethodFamily  @unique
  label       String
  active      Boolean              @default(true)

  @@map("payment_methods")
}

model PaymentRoutingRule {
  id          String   @id @db.Uuid
  countryId   String?  @map("country_id") @db.Uuid
  currency    String?
  method      PaymentMethodFamily
  gatewayCode String    @map("gateway_code")
  priority    Int       @default(100)
  active      Boolean   @default(true)
  country     Country?  @relation(fields: [countryId], references: [id])

  @@index([countryId, method, currency])
  @@map("payment_routing_rules")
}

model PaymentIntent {
  id                 String               @id @db.Uuid
  checkoutSessionId String?               @map("checkout_session_id") @db.Uuid
  checkoutQuoteId   String?               @map("checkout_quote_id") @db.Uuid
  labBookingId       String?               @map("lab_booking_id") @db.Uuid
  imagingBookingId   String?               @map("imaging_booking_id") @db.Uuid
  customerPersonId   String                @map("customer_person_id") @db.Uuid
  countryId          String                @map("country_id") @db.Uuid
  legalEntityId      String?              @map("legal_entity_id") @db.Uuid
  method             PaymentMethodFamily
  status             PaymentIntentStatus  @default(CREATED)
  amountMinor        BigInt               @map("amount_minor")
  currency           String               @db.Char(3)
  capturedMinor      BigInt               @default(0) @map("captured_minor")
  refundedMinor      BigInt               @default(0) @map("refunded_minor")
  fxSnapshotId      String?               @map("fx_snapshot_id") @db.Uuid
  idempotencyKey     String                @unique @map("idempotency_key")
  sandbox            Boolean              @default(true)
  nextAction         Json?               @map("next_action")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  checkoutSession    CheckoutSession?      @relation(fields: [checkoutSessionId], references: [id])
  checkoutQuote      CheckoutQuote?       @relation(fields: [checkoutQuoteId], references: [id])
  labBooking         LabBooking?          @relation(fields: [labBookingId], references: [id])
  imagingBooking     ImagingBooking?      @relation(fields: [imagingBookingId], references: [id])
  customer           Person               @relation(fields: [customerPersonId], references: [id])
  country            Country              @relation(fields: [countryId], references: [id])
  legalEntity        LegalEntity?        @relation(fields: [legalEntityId], references: [id])
  fxSnapshot         PaymentFxSnapshot?  @relation(fields: [fxSnapshotId], references: [id])
  attempts           PaymentAttempt[]
  transactions       PaymentTransaction[]
  refunds            Refund[]
  orders             Order[]
  financialFacts     FinancialFact[]

  @@index([customerPersonId, status])
  @@index([checkoutSessionId])
  @@index([labBookingId])
  @@index([imagingBookingId])
  @@map("payment_intents")
}

model PaymentAttempt {
  id             String                @id @db.Uuid
  intentId       String                 @map("intent_id") @db.Uuid
  gatewayId      String                 @map("gateway_id") @db.Uuid
  status         PaymentAttemptStatus   @default(CREATED)
  method         PaymentMethodFamily
  providerRef    String?               @map("provider_ref")
  routingJson    Json                  @map("routing_json")
  errorCode      String?               @map("error_code")
  submitted      Boolean               @default(false)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  intent         PaymentIntent          @relation(fields: [intentId], references: [id], onDelete: Cascade)
  gateway        PaymentGateway         @relation(fields: [gatewayId], references: [id])
  transactions   PaymentTransaction[]

  @@index([intentId, createdAt])
  @@map("payment_attempts")
}

model PaymentTransaction {
  id             String   @id @db.Uuid
  intentId       String    @map("intent_id") @db.Uuid
  attemptId      String?   @map("attempt_id") @db.Uuid
  kind           String
  amountMinor    BigInt   @map("amount_minor")
  currency       String    @db.Char(3)
  providerRef    String?  @map("provider_ref")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  intent         PaymentIntent  @relation(fields: [intentId], references: [id], onDelete: Cascade)
  attempt        PaymentAttempt? @relation(fields: [attemptId], references: [id])

  @@index([intentId, createdAt])
  @@map("payment_transactions")
}

model Refund {
  id            String       @id @db.Uuid
  intentId      String        @map("intent_id") @db.Uuid
  amountMinor   BigInt       @map("amount_minor")
  currency      String        @db.Char(3)
  status        RefundStatus @default(REQUESTED)
  reason        String?
  idempotencyKey String       @unique @map("idempotency_key")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  intent        PaymentIntent @relation(fields: [intentId], references: [id])
  attempts      RefundAttempt[]

  @@index([intentId, status])
  @@map("refunds")
}

model RefundAttempt {
  id          String   @id @db.Uuid
  refundId    String    @map("refund_id") @db.Uuid
  status      RefundStatus @default(PROCESSING)
  providerRef String?  @map("provider_ref")
  errorCode   String?  @map("error_code")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  refund      Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@map("refund_attempts")
}

model PaymentWebhookEvent {
  id               String   @id @db.Uuid
  gatewayId        String    @map("gateway_id") @db.Uuid
  providerEventId  String    @map("provider_event_id")
  eventType        String    @map("event_type")
