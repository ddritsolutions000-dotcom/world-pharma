generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Identity kernel (blueprint 03 / 20 / 27). No customer or partner profiles.

enum PersonStatus {
  ACTIVE
  PENDING
  DISABLED
  PENDING_DELETION
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum IdentifierType {
  PHONE
  EMAIL
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  REGISTER
  LOGIN
  VERIFY_EMAIL
  VERIFY_PHONE
  ACCOUNT_RECOVERY
  STEP_UP
}

enum OtpChallengeStatus {
  PENDING
  CONSUMED
  EXPIRED
  LOCKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  STOLEN
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipScope {
  platform
  region
  country
  legal_entity
  organization
  location
  self
}

enum OperatingRegionStatus {
  ACTIVE
  INACTIVE
}

enum LegalEntityStatus {
  CONFIGURED
  INACTIVE
}

/// Configurable grouping of countries. Codes are data, not hardcoded geography.
model OperatingRegion {
  id          String                 @id @db.Uuid
  code        String                  @unique
  nameI18n    Json                    @map("name_i18n")
  status      OperatingRegionStatus   @default(ACTIVE)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  countries       Country[]
  legalEntities   LegalEntity[]
  organizations   Organization[]
  locations       Location[]
  memberships     Membership[]
  carrierAccounts CarrierAccount[]
  outboxEvents    OutboxEvent[]

  @@map("operating_regions")
}

/// Company legal-entity configuration shell. Do not invent real legal names here.
model LegalEntity {
  id                       String            @id @db.Uuid
  code                     String             @unique
  displayName              String              @map("display_name")
  incorporationCountryId   String?            @map("incorporation_country_id") @db.Uuid
  regionId                 String?            @map("region_id") @db.Uuid
  operatingCurrency        String?            @map("operating_currency") @db.Char(3)
  timezone                 String?
  status                   LegalEntityStatus @default(CONFIGURED)
  notes                    String?
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  incorporationCountry     Country?           @relation("LegalEntityIncorporation", fields: [incorporationCountryId], references: [id])
  region                   OperatingRegion?   @relation(fields: [regionId], references: [id])
  businessUnits            BusinessUnit[]
  organizations            Organization[]
  memberships              Membership[]
  paymentGatewayAccounts   PaymentGatewayAccount[]
  carrierAccounts          CarrierAccount[]
  ledgerAccounts           LedgerAccount[]
  journals                 Journal[]
  outboxEvents             OutboxEvent[]
  orders                   Order[]
  paymentIntents           PaymentIntent[]

  @@index([regionId, status])
  @@map("legal_entities")
}

model BusinessUnit {
  id            String       @id @db.Uuid
  legalEntityId String?      @map("legal_entity_id") @db.Uuid
  code          String        @unique
  name          String
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id])

  @@map("business_units")
}

enum JwtAudience {
  customer
  partner_applicant
  admin
  doctor
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
}

model Person {
  id                String       @id @db.Uuid
  status            PersonStatus @default(PENDING)
  statusReason      String?      @map("status_reason")
  preferredLocale   String?      @map("preferred_locale")
  primaryCountryId  String?      @map("primary_country_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  account           Account?
  identifiers       AccountIdentifier[]
  sessions          Session[]
  devices           Device[]
  memberships       Membership[]
  otpChallenges     OtpChallenge[]
  securityEvents    SecurityEvent[]
  privilegeGrantsAsTarget     PrivilegeGrantRequest[] @relation("PrivilegeGrantTarget")
  privilegeGrantsRequested    PrivilegeGrantRequest[] @relation("PrivilegeGrantRequester")
  privilegeGrantsReviewed      PrivilegeGrantRequest[] @relation("PrivilegeGrantReviewer")
  breakGlassGrants            BreakGlassGrant[] @relation("BreakGlassSubject")
  breakGlassGranted            BreakGlassGrant[] @relation("BreakGlassActor")
  breakGlassReviewed           BreakGlassGrant[] @relation("BreakGlassReviewer")
  breakGlassPatients           BreakGlassGrant[] @relation("BreakGlassPatient")
  totpSecrets       TotpSecret[]
  recoveryCodes     RecoveryCode[]
  partners          Partner[]
  invitationsSent   PartnerInvitation[] @relation("InvitationInviter")
  carts             Cart[]
  addresses         CustomerAddress[]
  checkoutSessions  CheckoutSession[]
  idempotencyRecords IdempotencyRecord[]
  paymentIntents    PaymentIntent[]
  orders            Order[]
  doctorProfiles    DoctorProfile[]
  consentGrantsAsSubject ConsentGrant[] @relation("ConsentSubject")
  consentGrantsAsActor   ConsentGrant[] @relation("ConsentActor")
  clinicalRelationshipsAsPatient ClinicalRelationship[]
  clinicalAccessAudits ClinicalAccessAudit[]
  doctorVerificationReviews DoctorVerificationReview[]
  appointmentsAsCustomer Appointment[]
  appointmentTransitions AppointmentStatusHistory[]
  encountersAsCustomer Encounter[]
  encounterConsultNotesAsPatient EncounterConsultNote[] @relation("EncounterConsultNotePatient")
  videoSessionsAsCustomer VideoSession[]
  videoJoinAudits VideoJoinAudit[]
  riderPresence   RiderPresence?
  prescriptionsAsPatient Prescription[] @relation("PrescriptionPatient")
  prescriptionsCreated   Prescription[] @relation("PrescriptionCreatedBy")
  prescriptionVersionsCreated PrescriptionVersion[] @relation("PrescriptionVersionCreatedBy")
  prescriptionStatusChanges PrescriptionStatusHistory[] @relation("PrescriptionStatusActor")
  prescriptionErxSubmissions PrescriptionErxSubmission[] @relation("PrescriptionErxSubmissionActor")
  dispensingCasesClaimed DispensingCase[] @relation("DispensingCaseClaimedBy")
  dispenseEventsActor    DispenseEvent[] @relation("DispenseEventActor")
  rxCommerceHandoffs     RxCommerceHandoff[]
  refillRequests         RefillRequest[] @relation("RefillRequestCustomer")
  refillDecisions        RefillRequest[] @relation("RefillRequestDecider")
  refillHistoryActions   RefillRequestHistory[] @relation("RefillHistoryActor")
  rxSubscriptions        RxSubscription[]
  labBookings            LabBooking[]
  labBookingTransitions  LabBookingStatusHistory[]
  imagingBookings        ImagingBooking[]
  imagingBookingTransitions ImagingBookingStatusHistory[]
  imagingStudiesAssigned ImagingStudy[] @relation("ImagingStudyAssignee")
  imagingStudyTransitions ImagingStudyStatusHistory[] @relation("ImagingStudyActor")
  imagingAcquisitionsAsTechnician ImagingAcquisition[] @relation("ImagingAcquisitionTechnician")
  labSamplesAssigned     LabSample[] @relation("LabSampleAssignee")
  labSampleCocEvents     LabSampleCocEvent[] @relation("LabSampleCocActor")
  labReportsAssigned     LabReport[] @relation("LabReportPathologist")
  imagingReportsAssigned ImagingReport[] @relation("ImagingReportRadiologist")
  imagingReportVersionsEntered ImagingReportVersion[] @relation("ImagingReportEnteredBy")
  imagingReportVersionsVerified ImagingReportVersion[] @relation("ImagingReportVerifiedBy")
  imagingReportVersionsPublished ImagingReportVersion[] @relation("ImagingReportPublishedBy")
  imagingFindingLinesEntered ImagingFindingLine[] @relation("ImagingFindingLineEnteredBy")
  labReportVersionsEntered LabReportVersion[] @relation("LabReportEnteredBy")
  labReportVersionsVerified LabReportVersion[] @relation("LabReportVerifiedBy")
  labReportVersionsPublished LabReportVersion[] @relation("LabReportPublishedBy")
  labResultLinesEntered  LabResultLine[] @relation("LabResultLineEnteredBy")
  healthArtifacts        HealthArtifact[]
  healthArtifactUploads  HealthArtifactUpload[]
  healthTimelineEvents   HealthTimelineEvent[]
  healthArtifactAccessAuditsAsPatient HealthArtifactAccessAudit[] @relation("HealthAccessPatient")
  healthArtifactAccessAuditsAsActor   HealthArtifactAccessAudit[] @relation("HealthAccessActor")
  careNavigationSessions CareNavigationSession[]
  careNavAuditsAsActor   CareNavAudit[]
  careNavOverridesAsActor CareNavOverride[]
  physicalReportRequests PhysicalReportRequest[] @relation("PhysicalReportCustomer")
  imagingPhysicalReportRequests ImagingPhysicalReportRequest[] @relation("ImagingPhysicalReportCustomer")
  cmsContentItemsAuthored     CmsContentItem[] @relation("CmsContentAuthor")
  cmsContentRevisionsCreated  CmsContentRevision[] @relation("CmsRevisionAuthor")
  cmsContentPublications      CmsContentPublication[] @relation("CmsPublicationPublisher")
  cmsContentAssetsCreated     CmsContentAsset[] @relation("CmsAssetAuthor")
  cmsContentAuditsAsActor     CmsContentAudit[] @relation("CmsContentAuditActor")
  supportTickets              SupportTicket[] @relation("SupportTicketCustomer")
  supportTicketsAssigned      SupportTicket[] @relation("SupportTicketAssignee")
  supportTicketMessages       SupportTicketMessage[] @relation("SupportMessageAuthor")
  supportTicketEventsAsActor  SupportTicketEvent[] @relation("SupportEventActor")
  supportTicketAttachments    SupportTicketAttachment[] @relation("SupportAttachmentAuthor")
  marketingPreferences        MarketingPreference[]
  conversionEvents            ConversionEvent[]
  crmSegmentsCreated          CrmSegment[] @relation("CrmSegmentCreator")
  crmCampaignsCreated         CrmCampaign[] @relation("CrmCampaignCreator")
  promoCampaignsCreated       PromoCampaign[] @relation("PromoCampaignCreator")
  affiliateReferralCodesCreated AffiliateReferralCode[] @relation("AffiliateReferralCodeCreator")
  affiliateLinksCreated       AffiliateLink[] @relation("AffiliateLinkCreator")
  crmCampaignSends            CrmCampaignSend[]
  crmSuppressions             CrmSuppression[]
  crmAutomationRuns           CrmAutomationRun[]
  wishlistItems               WishlistItem[]
  loyaltyAccounts             LoyaltyAccount[]
  productReviewsAuthored      ProductReview[] @relation("ProductReviewAuthor")
  productReviewResponses      ProductReviewResponse[]
  productQuestionsAuthored    ProductQuestion[] @relation("ProductQuestionAuthor")
  personalizationEvents       PersonalizationEvent[]

  @@map("persons")
}

model Account {
  id               String        @id @db.Uuid
  personId         String        @unique @map("person_id") @db.Uuid
  status           AccountStatus @default(ACTIVE)
  passwordHash     String?       @map("password_hash")
  mfaRequired      Boolean       @default(false) @map("mfa_required")
  failedLoginCount Int           @default(0) @map("failed_login_count")
  lockedUntil      DateTime?    @map("locked_until") @db.Timestamptz
  lastLoginAt      DateTime?    @map("last_login_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  person           Person        @relation(fields: [personId], references: [id])
  sessions         Session[]
  totpSecrets      TotpSecret[]

  @@map("accounts")
}

model AccountIdentifier {
  id               String         @id @db.Uuid
  personId         String         @map("person_id") @db.Uuid
  type             IdentifierType
  valueNormalized  String         @map("value_normalized")
  verifiedAt       DateTime?     @map("verified_at") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  person           Person         @relation(fields: [personId], references: [id])

  @@unique([type, valueNormalized])
  @@index([personId])
  @@map("account_identifiers")
}

model OtpChallenge {
  id                  String              @id @db.Uuid
  personId            String?             @map("person_id") @db.Uuid
  identifierType      IdentifierType      @map("identifier_type")
  identifierNormalized String              @map("identifier_normalized")
  channel             OtpChannel
  purpose             OtpPurpose
  codeHmac            String              @map("code_hmac")
  status              OtpChallengeStatus   @default(PENDING)
  attemptCount        Int                 @default(0) @map("attempt_count")
  maxAttempts         Int                 @default(5) @map("max_attempts")
  expiresAt           DateTime            @map("expires_at") @db.Timestamptz
  consumedAt          DateTime?           @map("consumed_at") @db.Timestamptz
  resendAvailableAt   DateTime            @map("resend_available_at") @db.Timestamptz
  ipHash              String?            @map("ip_hash")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  person              Person?             @relation(fields: [personId], references: [id])

  @@index([identifierNormalized, purpose, createdAt])
  @@index([status, expiresAt])
  @@map("otp_challenges")
}

model Device {
  id          String         @id @db.Uuid
  personId    String          @map("person_id") @db.Uuid
  platform    DevicePlatform
  status      DeviceStatus   @default(ACTIVE)
  countryId   String?        @map("country_id") @db.Uuid
  boundAt     DateTime       @default(now()) @map("bound_at") @db.Timestamptz
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  person      Person         @relation(fields: [personId], references: [id])
  sessions    Session[]

  @@index([personId, status])
  @@map("devices")
}

model Session {
  id            String        @id @db.Uuid
  personId      String         @map("person_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  deviceId      String?        @map("device_id") @db.Uuid
  membershipId  String?        @map("membership_id") @db.Uuid
  audience      JwtAudience
  countryId     String?        @map("country_id") @db.Uuid
  status        SessionStatus @default(ACTIVE)
  tokenVersion  Int           @default(1) @map("token_version")
  ipHash        String?       @map("ip_hash")
  userAgentHash String?       @map("user_agent_hash")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt    DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz
  revokedAt     DateTime?     @map("revoked_at") @db.Timestamptz

  person        Person        @relation(fields: [personId], references: [id])
  account       Account        @relation(fields: [accountId], references: [id])
  device        Device?        @relation(fields: [deviceId], references: [id])
  refreshTokens RefreshToken[]

  @@index([personId, status])
  @@map("sessions")
}

model RefreshToken {
  id          String             @id @db.Uuid
  sessionId   String              @map("session_id") @db.Uuid
  familyId    String              @map("family_id") @db.Uuid
  tokenHash   String             @unique @map("token_hash")
  status      RefreshTokenStatus @default(ACTIVE)
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz
  rotatedAt   DateTime?          @map("rotated_at") @db.Timestamptz
  revokedAt   DateTime?          @map("revoked_at") @db.Timestamptz
  reusedAt    DateTime?          @map("reused_at") @db.Timestamptz
  replacedById String?           @map("replaced_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz

  session     Session            @relation(fields: [sessionId], references: [id])

  @@index([sessionId, status])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Role {
  id           String       @id @db.Uuid
  code         String        @unique
  name         String
  isSystem     Boolean       @default(true) @map("is_system")
  parentRoleId String?      @map("parent_role_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  parent       Role?        @relation("RoleParent", fields: [parentRoleId], references: [id])
  children     Role[]       @relation("RoleParent")
  permissions  RolePermission[]
  memberships  Membership[]

  @@map("roles")
}

model Permission {
  id        String   @id @db.Uuid
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission  @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String           @id @db.Uuid
  personId       String            @map("person_id") @db.Uuid
  roleId         String            @map("role_id") @db.Uuid
  scope          MembershipScope
  countryId      String?          @map("country_id") @db.Uuid
  regionId       String?          @map("region_id") @db.Uuid
  legalEntityId  String?          @map("legal_entity_id") @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  locationId     String?          @map("location_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  startsAt       DateTime         @default(now()) @map("starts_at") @db.Timestamptz
  endsAt         DateTime?         @map("ends_at") @db.Timestamptz
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  person         Person           @relation(fields: [personId], references: [id])
  role           Role             @relation(fields: [roleId], references: [id])
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  region         OperatingRegion? @relation(fields: [regionId], references: [id])
  legalEntity    LegalEntity?     @relation(fields: [legalEntityId], references: [id])

  @@unique([personId, organizationId, roleId])
  @@index([personId, status])
  @@index([organizationId, status])
  @@map("memberships")
}

model TotpSecret {
  id            String    @id @db.Uuid
  personId      String     @map("person_id") @db.Uuid
  accountId     String     @map("account_id") @db.Uuid
  secretCipher  String     @map("secret_cipher")
  enrolledAt    DateTime? @map("enrolled_at") @db.Timestamptz
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  person        Person    @relation(fields: [personId], references: [id])
  account       Account    @relation(fields: [accountId], references: [id])

  @@index([personId])
  @@map("totp_secrets")
}

model RecoveryCode {
  id         String    @id @db.Uuid
  personId   String     @map("person_id") @db.Uuid
  codeHash   String     @map("code_hash")
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  person     Person    @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("recovery_codes")
}

model SecurityEvent {
  id            String   @id @db.Uuid
  type          String
  personId      String?   @map("person_id") @db.Uuid
  sessionId     String?   @map("session_id") @db.Uuid
  outcome       String
  requestId     String?   @map("request_id")
  ipHash        String?   @map("ip_hash")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  person        Person?  @relation(fields: [personId], references: [id])

  @@index([personId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

enum PrivilegeGrantStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model PrivilegeGrantRequest {
  id             String                @id @db.Uuid
  kind           String
  targetPersonId String                 @map("target_person_id") @db.Uuid
  roleCode       String                 @map("role_code")
  scope          MembershipScope      @default(platform)
  countryId      String?               @map("country_id") @db.Uuid
  requestedById  String                 @map("requested_by_id") @db.Uuid
  reviewedById   String?               @map("reviewed_by_id") @db.Uuid
  status         PrivilegeGrantStatus @default(PENDING)
  reason         String
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  reviewedAt     DateTime?             @map("reviewed_at") @db.Timestamptz

  target         Person                @relation("PrivilegeGrantTarget", fields: [targetPersonId], references: [id])
  requestedBy    Person                @relation("PrivilegeGrantRequester", fields: [requestedById], references: [id])
  reviewedBy     Person?               @relation("PrivilegeGrantReviewer", fields: [reviewedById], references: [id])

  @@index([targetPersonId, status])
  @@index([status, createdAt])
  @@map("privilege_grant_requests")
}

enum BreakGlassGrantKind {
  PLATFORM
  HEALTH_CLINICAL
}

enum BreakGlassReviewStatus {
  PENDING
  REVIEWED
  CLOSED
}

model BreakGlassGrant {
  id               String                  @id @db.Uuid
  kind             BreakGlassGrantKind     @default(PLATFORM)
  personId         String                  @map("person_id") @db.Uuid
  grantedById      String                  @map("granted_by_id") @db.Uuid
  reason           String
  permissions      Json
  expiresAt        DateTime                @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?               @map("revoked_at") @db.Timestamptz
  countryId        String?                 @map("country_id") @db.Uuid
  patientPersonId  String?                 @map("patient_person_id") @db.Uuid
  doctorPartnerId  String?                 @map("doctor_partner_id") @db.Uuid
  ticketId         String?                 @map("ticket_id")
  reviewStatus     BreakGlassReviewStatus  @default(PENDING) @map("review_status")
  reviewedAt       DateTime?               @map("reviewed_at") @db.Timestamptz
  reviewedById     String?                 @map("reviewed_by_id") @db.Uuid
  reviewNotes      String?                 @map("review_notes")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz

  person           Person                  @relation("BreakGlassSubject", fields: [personId], references: [id])
  grantedBy        Person                  @relation("BreakGlassActor", fields: [grantedById], references: [id])
  reviewedBy       Person?                 @relation("BreakGlassReviewer", fields: [reviewedById], references: [id])
  country          Country?                @relation(fields: [countryId], references: [id])
  patient          Person?                 @relation("BreakGlassPatient", fields: [patientPersonId], references: [id])
  doctorPartner    Partner?                @relation(fields: [doctorPartnerId], references: [id])
  bridgedConsents  ConsentGrant[]

  @@index([personId, expiresAt])
  @@index([kind, reviewStatus, createdAt])
  @@index([patientPersonId, doctorPartnerId])
  @@map("break_glass_grants")
}

// Country Policy Packs (blueprint 18 / 20). Configuration, not country-specific code.

enum CountryStatus {
  INACTIVE
  ACTIVE
}

enum PolicyPackStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

model PartnerType {
  id        String   @id @db.Uuid
  code      String    @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  partners  Partner[]

  @@map("partner_types")
}

model Country {
  id                      String        @id @db.Uuid
  isoAlpha2               String         @unique @map("iso3166_a2")
  isoAlpha3               String         @map("iso3166_a3")
  nameI18n                Json          @map("name_i18n")
  status                  CountryStatus  @default(INACTIVE)
  defaultLocale           String         @map("default_locale")
  defaultCurrency         String         @map("default_currency")
  defaultTimezone         String         @map("default_timezone")
  phonePrefix             String?        @map("phone_prefix")
  publishedPolicyPackId  String?        @map("published_policy_pack_id") @db.Uuid
  dataResidencyMode       String         @default("shared") @map("data_residency_mode")
  regionId                String?        @map("region_id") @db.Uuid
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  region                  OperatingRegion? @relation(fields: [regionId], references: [id])
  incorporatedLegalEntities LegalEntity[] @relation("LegalEntityIncorporation")
  policyPacks             PolicyPack[]
  partners                Partner[]
  organizations           Organization[]
  catalogItemCountries     CatalogItemCountry[]
  catalogOffers           CatalogOffer[]
  commercialRules         CommercialRule[]
  catalogSearchDocuments  CatalogSearchDocument[]
  providerDoctorSearchDocuments ProviderDoctorSearchDocument[]
  providerLabSearchDocuments    ProviderLabSearchDocument[]
  providerTestSearchDocuments     ProviderTestSearchDocument[]
  providerPharmacySearchDocuments ProviderPharmacySearchDocument[]
  clinicalSearchDocuments ClinicalSearchDocument[]
  searchIndexJobs         SearchIndexJob[]
  analyticsOrderItemPairs AnalyticsOrderItemPair[]
  analyticsDailyCountryMetrics AnalyticsDailyCountryMetric[]
  analyticsDailyProductMetrics AnalyticsDailyProductMetric[]
  analyticsDailyMarketingMetrics AnalyticsDailyMarketingMetric[]
  analyticsIngestCursors AnalyticsIngestCursor[]
  inventoryLots           InventoryLot[]
  goodsReceipts           GoodsReceipt[]
  stockTransfers          StockTransfer[]
  carts                   Cart[]
  customerAddresses       CustomerAddress[]
  checkoutSessions        CheckoutSession[]
  promoCampaigns          PromoCampaign[]
  paymentIntents          PaymentIntent[]
  paymentGatewayAccounts  PaymentGatewayAccount[]
