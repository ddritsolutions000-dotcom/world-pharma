  status             ImagingBookingStatus @default(BOOKED)
  currency           String               @db.Char(3)
  totalMinor         BigInt               @map("total_minor")
  slotStartsAt       DateTime?            @map("slot_starts_at") @db.Timestamptz
  slotEndsAt         DateTime?            @map("slot_ends_at") @db.Timestamptz
  timezone           String?
  paymentIntentId    String?              @map("payment_intent_id") @db.Uuid
  idempotencyKey     String               @unique @map("idempotency_key")
  sandbox            Boolean              @default(true)
  prepAcknowledged   Boolean              @default(false) @map("prep_acknowledged")
  referralReference  String?              @map("referral_reference")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  country            Country              @relation(fields: [countryId], references: [id])
  customer           Person               @relation(fields: [customerPersonId], references: [id])
  imagingOrg         Organization         @relation(fields: [imagingOrgId], references: [id])
  imagingLocation    Location             @relation(fields: [imagingLocationId], references: [id])
  lines              ImagingBookingLine[]
  history            ImagingBookingStatusHistory[]
  paymentIntents     PaymentIntent[]
  referral           ImagingReferral?
  study              ImagingStudy?
  report             ImagingReport?
  healthArtifacts    HealthArtifact[]
  physicalReportRequest ImagingPhysicalReportRequest?

  @@index([customerPersonId, status])
  @@index([imagingOrgId, status])
  @@index([countryId, status])
  @@index([imagingLocationId, slotStartsAt, slotEndsAt])
  @@map("imaging_bookings")
}

model ImagingBookingLine {
  id               String         @id @db.Uuid
  imagingBookingId String         @map("imaging_booking_id") @db.Uuid
  offerId          String         @map("offer_id") @db.Uuid
  variantId        String         @map("variant_id") @db.Uuid
  title            String
  qty              Int            @default(1)
  unitMinor        BigInt         @map("unit_minor")
  lineMinor        BigInt         @map("line_minor")
  currency         String         @db.Char(3)
  priceVersion     Int?           @map("price_version")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  booking ImagingBooking @relation(fields: [imagingBookingId], references: [id], onDelete: Cascade)
  offer     CatalogOffer   @relation(fields: [offerId], references: [id])
  variant   CatalogVariant @relation(fields: [variantId], references: [id])

  @@index([imagingBookingId])
  @@index([offerId])
  @@map("imaging_booking_lines")
}

model ImagingBookingStatusHistory {
  id               String               @id @db.Uuid
  imagingBookingId String               @map("imaging_booking_id") @db.Uuid
  fromStatus       ImagingBookingStatus @map("from_status")
  toStatus         ImagingBookingStatus @map("to_status")
  actorPersonId    String               @map("actor_person_id") @db.Uuid
  reasonCode       String?              @map("reason_code")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz

  booking ImagingBooking @relation(fields: [imagingBookingId], references: [id], onDelete: Cascade)
  actor   Person         @relation(fields: [actorPersonId], references: [id])

  @@index([imagingBookingId, createdAt])
  @@map("imaging_booking_status_history")
}

/// R8-B: optional referral record when country pack requires clinical authorization.
model ImagingReferral {
  id                String   @id @db.Uuid
  imagingBookingId  String   @unique @map("imaging_booking_id") @db.Uuid
  referralReference String?  @map("referral_reference")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking ImagingBooking @relation(fields: [imagingBookingId], references: [id], onDelete: Cascade)

  @@map("imaging_referrals")
}

/// R8-C: imaging study procedure instance (1:1 with booking in sandbox v1).
enum ImagingStudyStatus {
  SCHEDULED
  CHECKED_IN
  ACQUISITION_IN_PROGRESS
  ACQUIRED
  ACQUISITION_FAILED
  CANCELLED
}

enum ImagingAcquisitionStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model ImagingStudy {
  id                String             @id @db.Uuid
  imagingBookingId  String             @unique @map("imaging_booking_id") @db.Uuid
  imagingOrgId      String             @map("imaging_org_id") @db.Uuid
  imagingLocationId String             @map("imaging_location_id") @db.Uuid
  countryId         String             @map("country_id") @db.Uuid
  status            ImagingStudyStatus @default(SCHEDULED)
  accessionNumber   String             @unique @map("accession_number")
  modalityCode      String?            @map("modality_code")
  bodyRegionCode    String?            @map("body_region_code")
  assigneePersonId  String?            @map("assignee_person_id") @db.Uuid
  idempotencyKey    String?            @unique @map("idempotency_key")
  sandbox           Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  booking       ImagingBooking              @relation(fields: [imagingBookingId], references: [id], onDelete: Cascade)
  imagingOrg    Organization                @relation(fields: [imagingOrgId], references: [id])
  imagingLocation Location                  @relation(fields: [imagingLocationId], references: [id])
  country       Country                     @relation(fields: [countryId], references: [id])
  assignee      Person?                     @relation("ImagingStudyAssignee", fields: [assigneePersonId], references: [id])
  acquisition   ImagingAcquisition?
  history       ImagingStudyStatusHistory[]
  report        ImagingReport?

  @@index([imagingOrgId, status])
  @@index([countryId, status])
  @@index([assigneePersonId, status])
  @@map("imaging_studies")
}

model ImagingStudyStatusHistory {
  id             String              @id @db.Uuid
  imagingStudyId String              @map("imaging_study_id") @db.Uuid
  fromStatus     ImagingStudyStatus? @map("from_status")
  toStatus       ImagingStudyStatus  @map("to_status")
  actorPersonId  String              @map("actor_person_id") @db.Uuid
  actionCode     String              @map("action_code")
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  study ImagingStudy @relation(fields: [imagingStudyId], references: [id], onDelete: Cascade)
  actor Person       @relation("ImagingStudyActor", fields: [actorPersonId], references: [id])

  @@index([imagingStudyId, createdAt])
  @@map("imaging_study_status_history")
}

/// R8-C: sandbox acquisition metadata + opaque object pointer (no DICOM payload).
model ImagingAcquisition {
  id                 String                   @id @db.Uuid
  imagingStudyId     String                   @unique @map("imaging_study_id") @db.Uuid
  status             ImagingAcquisitionStatus @default(IN_PROGRESS)
  technicianPersonId String?                  @map("technician_person_id") @db.Uuid
  startedAt          DateTime?                @map("started_at") @db.Timestamptz
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz
  sandboxObjectRef   String?                  @map("sandbox_object_ref")
  equipmentCode      String?                  @map("equipment_code")
  failureCode        String?                  @map("failure_code")
  metadata           Json?
  sandbox            Boolean                  @default(true)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  study      ImagingStudy @relation(fields: [imagingStudyId], references: [id], onDelete: Cascade)
  technician Person?      @relation("ImagingAcquisitionTechnician", fields: [technicianPersonId], references: [id])

  @@index([technicianPersonId, status])
  @@map("imaging_acquisitions")
}

/// R8-D: radiologist interpretation (stops before R8-E customer publication).
enum ImagingReportVersionStatus {
  DRAFT
  PENDING_VERIFY
  VERIFIED
  PUBLISHED
}

model ImagingReport {
  id                          String    @id @db.Uuid
  imagingStudyId              String    @unique @map("imaging_study_id") @db.Uuid
  imagingBookingId            String    @unique @map("imaging_booking_id") @db.Uuid
  imagingOrgId                String    @map("imaging_org_id") @db.Uuid
  countryId                   String    @map("country_id") @db.Uuid
  assignedRadiologistPersonId String?   @map("assigned_radiologist_person_id") @db.Uuid
  currentVersionId            String?   @unique @map("current_version_id") @db.Uuid
  sandbox                     Boolean   @default(true)
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  study                 ImagingStudy           @relation(fields: [imagingStudyId], references: [id], onDelete: Cascade)
  booking               ImagingBooking         @relation(fields: [imagingBookingId], references: [id], onDelete: Cascade)
  imagingOrg            Organization           @relation(fields: [imagingOrgId], references: [id])
  country               Country                @relation(fields: [countryId], references: [id])
  assignedRadiologist   Person?                @relation("ImagingReportRadiologist", fields: [assignedRadiologistPersonId], references: [id])
  currentVersion        ImagingReportVersion?  @relation("ImagingReportCurrentVersion", fields: [currentVersionId], references: [id])
  versions              ImagingReportVersion[] @relation("ImagingReportVersions")
  physicalReportRequests ImagingPhysicalReportRequest[]

  @@index([imagingOrgId, createdAt])
  @@map("imaging_reports")
}

model ImagingReportVersion {
  id                  String                     @id @db.Uuid
  imagingReportId     String                     @map("imaging_report_id") @db.Uuid
  versionNumber       Int                        @map("version_number")
  status              ImagingReportVersionStatus @default(DRAFT)
  summary             String?
  objectKey           String?                    @map("object_key")
  enteredByPersonId   String                     @map("entered_by_person_id") @db.Uuid
  verifiedByPersonId  String?                    @map("verified_by_person_id") @db.Uuid
  publishedByPersonId String?                    @map("published_by_person_id") @db.Uuid
  amendsVersionId     String?                    @map("amends_version_id") @db.Uuid
  amendmentReason     String?                    @map("amendment_reason")
  publishedAt         DateTime?                  @map("published_at") @db.Timestamptz
  sandbox             Boolean                    @default(true)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  report           ImagingReport          @relation("ImagingReportVersions", fields: [imagingReportId], references: [id], onDelete: Cascade)
  currentForReport ImagingReport?         @relation("ImagingReportCurrentVersion")
  amendsVersion    ImagingReportVersion?  @relation("ImagingReportAmendment", fields: [amendsVersionId], references: [id])
  amendedBy        ImagingReportVersion[] @relation("ImagingReportAmendment")
  enteredBy        Person                 @relation("ImagingReportEnteredBy", fields: [enteredByPersonId], references: [id])
  verifiedBy       Person?                @relation("ImagingReportVerifiedBy", fields: [verifiedByPersonId], references: [id])
  publishedBy      Person?                @relation("ImagingReportPublishedBy", fields: [publishedByPersonId], references: [id])
  findingLines     ImagingFindingLine[]
  healthArtifact   HealthArtifact?
  physicalReportRequests ImagingPhysicalReportRequest[]

  @@unique([imagingReportId, versionNumber])
  @@index([imagingReportId, status])
  @@map("imaging_report_versions")
}

model ImagingFindingLine {
  id                     String   @id @db.Uuid
  imagingReportVersionId String   @map("imaging_report_version_id") @db.Uuid
  findingCode            String   @map("finding_code")
  findingText            String   @map("finding_text")
  bodyRegionCode         String?  @map("body_region_code")
  severityCode           String?  @map("severity_code")
  sortOrder              Int      @default(0) @map("sort_order")
  enteredByPersonId      String   @map("entered_by_person_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  version   ImagingReportVersion @relation(fields: [imagingReportVersionId], references: [id], onDelete: Cascade)
  enteredBy Person               @relation("ImagingFindingLineEnteredBy", fields: [enteredByPersonId], references: [id])

  @@index([imagingReportVersionId])
  @@map("imaging_finding_lines")
}

// --- R11-A: CMS + Support Desk kernel ---

enum CmsContentType {
  ARTICLE
  FAQ
  KB
  BANNER
  LANDING
  LEGAL_NOTICE
  PACK_STRING
}

enum CmsContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum SupportTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportMessageVisibility {
  CUSTOMER
  INTERNAL
}

model CmsContentItem {
  id               String           @id @db.Uuid
  countryId        String           @map("country_id") @db.Uuid
  contentType      CmsContentType   @map("content_type")
  slug             String
  locale           String           @default("en")
  status           CmsContentStatus @default(DRAFT)
  categorySlug     String?          @map("category_slug")
  title            String
  summary          String           @default("")
  body             String           @default("")
  authorPersonId   String           @map("author_person_id") @db.Uuid
  publishedVersion Int              @default(0) @map("published_version")
  version          Int              @default(1)
  sandbox          Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  country       Country                @relation(fields: [countryId], references: [id])
  author        Person                 @relation("CmsContentAuthor", fields: [authorPersonId], references: [id])
  revisions     CmsContentRevision[]
  publications  CmsContentPublication[]
  assets        CmsContentAsset[]
  audits        CmsContentAudit[]
  searchDocument CmsContentSearchDocument?

  @@unique([countryId, slug, locale])
  @@index([countryId, status])
  @@index([countryId, contentType, categorySlug])
  @@map("cms_content_items")
}

model CmsContentRevision {
  id                String   @id @db.Uuid
  contentItemId     String   @map("content_item_id") @db.Uuid
  revisionNumber    Int      @map("revision_number")
  title             String
  summary           String   @default("")
  body              String   @default("")
  createdByPersonId String   @map("created_by_person_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  contentItem CmsContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  createdBy   Person         @relation("CmsRevisionAuthor", fields: [createdByPersonId], references: [id])

  @@unique([contentItemId, revisionNumber])
  @@map("cms_content_revisions")
}

model CmsContentPublication {
  id                  String   @id @db.Uuid
  contentItemId       String   @map("content_item_id") @db.Uuid
  publicationVersion  Int      @map("publication_version")
  revisionNumber      Int      @map("revision_number")
  title               String
  summary             String   @default("")
  body                String   @default("")
  publishedByPersonId String   @map("published_by_person_id") @db.Uuid
  idempotencyKey      String?  @map("idempotency_key")
  publishedAt         DateTime @default(now()) @map("published_at") @db.Timestamptz

  contentItem CmsContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  publishedBy Person         @relation("CmsPublicationPublisher", fields: [publishedByPersonId], references: [id])

  @@unique([contentItemId, publicationVersion])
  @@unique([contentItemId, idempotencyKey])
  @@map("cms_content_publications")
}

model CmsContentAsset {
  id                String   @id @db.Uuid
  contentItemId     String?  @map("content_item_id") @db.Uuid
  countryId         String   @map("country_id") @db.Uuid
  storageKey        String   @map("storage_key")
  contentType       String   @map("content_type")
  byteSize          Int      @map("byte_size")
  checksumSha256    String   @map("checksum_sha256")
  createdByPersonId String   @map("created_by_person_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  contentItem CmsContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  country     Country           @relation(fields: [countryId], references: [id])
  createdBy   Person            @relation("CmsAssetAuthor", fields: [createdByPersonId], references: [id])

  @@index([contentItemId])
  @@map("cms_content_assets")
}

model CmsContentSearchDocument {
  id            String         @id @db.Uuid
  contentItemId String         @unique @map("content_item_id") @db.Uuid
  countryId     String         @map("country_id") @db.Uuid
  locale        String
  slug          String
  contentType   CmsContentType @map("content_type")
  categorySlug  String?        @map("category_slug")
  title         String
  body          String         @default("")
  published     Boolean        @default(true)
  publishedAt   DateTime       @map("published_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  contentItem CmsContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  country     Country        @relation(fields: [countryId], references: [id])

  @@index([countryId, locale, published])
  @@map("cms_content_search_documents")
}

model CmsContentAudit {
  id            String   @id @db.Uuid
  contentItemId String   @map("content_item_id") @db.Uuid
  actorPersonId String?  @map("actor_person_id") @db.Uuid
  action        String
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  contentItem CmsContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  actor       Person?        @relation("CmsContentAuditActor", fields: [actorPersonId], references: [id])

  @@index([contentItemId, createdAt])
  @@map("cms_content_audits")
}

model SupportQueue {
  id        String   @id @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  country Country         @relation(fields: [countryId], references: [id])
  tickets SupportTicket[]

  @@unique([countryId, code])
  @@map("support_queues")
}

model SupportTicket {
  id               String              @id @db.Uuid
  personId         String              @map("person_id") @db.Uuid
  countryId        String              @map("country_id") @db.Uuid
  queueId          String              @map("queue_id") @db.Uuid
  status           SupportTicketStatus @default(OPEN)
  subject          String
  referenceType    String?             @map("reference_type")
  referenceId      String?             @map("reference_id") @db.Uuid
  assigneePersonId String?             @map("assignee_person_id") @db.Uuid
  idempotencyKey   String?             @map("idempotency_key")
  version          Int                 @default(1)
  sandbox          Boolean             @default(true)
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  person    Person                    @relation("SupportTicketCustomer", fields: [personId], references: [id])
  country   Country                   @relation(fields: [countryId], references: [id])
  queue     SupportQueue              @relation(fields: [queueId], references: [id])
  assignee  Person?                   @relation("SupportTicketAssignee", fields: [assigneePersonId], references: [id])
  messages  SupportTicketMessage[]
  events    SupportTicketEvent[]
  attachments SupportTicketAttachment[]

  @@unique([personId, idempotencyKey])
  @@index([personId, createdAt(sort: Desc)])
  @@index([countryId, status])
  @@index([queueId, status])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id               String                   @id @db.Uuid
  ticketId         String                   @map("ticket_id") @db.Uuid
  authorPersonId   String                   @map("author_person_id") @db.Uuid
  visibility       SupportMessageVisibility
  body             String
  idempotencyKey   String?                  @map("idempotency_key")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author   Person        @relation("SupportMessageAuthor", fields: [authorPersonId], references: [id])
  attachments SupportTicketAttachment[]

  @@unique([ticketId, idempotencyKey])
  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model SupportTicketEvent {
  id            String               @id @db.Uuid
  ticketId      String               @map("ticket_id") @db.Uuid
  actorPersonId String?              @map("actor_person_id") @db.Uuid
  action        String
  fromStatus    SupportTicketStatus? @map("from_status")
  toStatus      SupportTicketStatus? @map("to_status")
  metadata      Json                 @default("{}")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  Person?       @relation("SupportEventActor", fields: [actorPersonId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_ticket_events")
}

model SupportTicketAttachment {
  id                String   @id @db.Uuid
  ticketId          String   @map("ticket_id") @db.Uuid
  messageId         String?  @map("message_id") @db.Uuid
  objectKey         String   @map("object_key")
  contentType       String   @map("content_type")
  byteSize          Int      @map("byte_size")
  createdByPersonId String   @map("created_by_person_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket    SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   SupportTicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdBy Person                @relation("SupportAttachmentAuthor", fields: [createdByPersonId], references: [id])

  @@index([ticketId])
  @@map("support_ticket_attachments")
}

/// R12-A durable marketing opt-in per person × country. Transactional prefs remain in Redis notification kernel.
model MarketingPreference {
  id               String   @id @db.Uuid
  personId         String   @map("person_id") @db.Uuid
  countryId        String   @map("country_id") @db.Uuid
  marketingAllowed Boolean  @default(false) @map("marketing_allowed")
  emailAllowed     Boolean  @default(false) @map("email_allowed")
  pushAllowed      Boolean  @default(false) @map("push_allowed")
  smsAllowed       Boolean  @default(false) @map("sms_allowed")
  whatsappAllowed  Boolean  @default(false) @map("whatsapp_allowed")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  person  Person  @relation(fields: [personId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@unique([personId, countryId])
  @@index([countryId, marketingAllowed])
  @@map("marketing_preferences")
}

enum ConversionEventKind {
  ORDER_PAID
  CHECKOUT_STARTED
  CART_ABANDONED
  BOOKING_COMPLETED
  AFFILIATE_CLICK
  APPOINTMENT_COMPLETED
  LAB_BOOKING_COMPLETED
  IMAGING_BOOKING_COMPLETED
}

/// R12-A append-only operational conversion feed (not R13 analytics).
model ConversionEvent {
  id         String              @id @db.Uuid
  countryId  String              @map("country_id") @db.Uuid
  personId   String?             @map("person_id") @db.Uuid
  orderId    String?             @map("order_id") @db.Uuid
  sessionId  String?             @map("session_id") @db.Uuid
  source     String
  sourceKey  String              @map("source_key")
  eventKind  ConversionEventKind @map("event_kind")
  occurredAt DateTime            @default(now()) @map("occurred_at") @db.Timestamptz
  metadata   Json                @default("{}")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  country Country @relation(fields: [countryId], references: [id])
  person  Person? @relation(fields: [personId], references: [id])

  @@unique([source, sourceKey, eventKind])
  @@index([countryId, occurredAt])
  @@index([personId, occurredAt])
  @@map("conversion_events")
}

/// R12-B marketing segment definitions (rules v1 JSON, non-clinical).
enum CrmSegmentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model CrmSegment {
  id                 String           @id @db.Uuid
  countryId          String           @map("country_id") @db.Uuid
  code               String
  name               String
  status             CrmSegmentStatus @default(DRAFT)
  rules              Json             @default("{}")
  version            Int              @default(1)
  createdByPersonId  String           @map("created_by_person_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  country   Country       @relation(fields: [countryId], references: [id])
  createdBy Person        @relation("CrmSegmentCreator", fields: [createdByPersonId], references: [id])
  campaigns CrmCampaign[]

  @@unique([countryId, code])
  @@index([countryId, status])
  @@map("crm_segments")
}

enum CrmCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
}

enum CrmCampaignChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
  WHATSAPP
}

/// R12-B marketing campaign header.
model CrmCampaign {
  id                String             @id @db.Uuid
  countryId         String             @map("country_id") @db.Uuid
  segmentId         String             @map("segment_id") @db.Uuid
  code              String
  name              String
  status            CrmCampaignStatus  @default(DRAFT)
  channel           CrmCampaignChannel @default(IN_APP)
  locale            String             @default("en")
  title             String
  body              String
  cmsContentId      String?            @map("cms_content_id") @db.Uuid
  scheduledAt       DateTime?          @map("scheduled_at") @db.Timestamptz
  version           Int                @default(1)
  createdByPersonId String             @map("created_by_person_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  country   Country          @relation(fields: [countryId], references: [id])
  segment   CrmSegment       @relation(fields: [segmentId], references: [id])
  createdBy Person           @relation("CrmCampaignCreator", fields: [createdByPersonId], references: [id])
  sends     CrmCampaignSend[]

  @@unique([countryId, code])
  @@index([countryId, status])
  @@map("crm_campaigns")
}

enum CrmCampaignSendStatus {
  SENT
  SKIPPED
}

/// R12-B append-only campaign send log per person.
model CrmCampaignSend {
  id             String                @id @db.Uuid
  campaignId     String                @map("campaign_id") @db.Uuid
  personId       String                @map("person_id") @db.Uuid
  countryId      String                @map("country_id") @db.Uuid
  idempotencyKey String                @map("idempotency_key")
  variant        String                @default("default")
  status         CrmCampaignSendStatus
  skipReason     String?               @map("skip_reason")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  campaign CrmCampaign @relation(fields: [campaignId], references: [id])
  person   Person      @relation(fields: [personId], references: [id])
  country  Country     @relation(fields: [countryId], references: [id])

  @@unique([campaignId, personId, idempotencyKey])
  @@index([campaignId, createdAt])
  @@index([personId, createdAt])
  @@map("crm_campaign_sends")
}

enum CrmSuppressionChannel {
