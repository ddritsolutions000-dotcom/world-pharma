  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  appointment      Appointment       @relation(fields: [appointmentId], references: [id])
  country          Country          @relation(fields: [countryId], references: [id])
  customer         Person           @relation(fields: [customerPersonId], references: [id])
  doctorProfile    DoctorProfile     @relation(fields: [doctorProfileId], references: [id])
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  videoSessions    VideoSession[]
  prescriptions    Prescription[]
  consultNote      EncounterConsultNote?
  healthArtifact   HealthArtifact?

  @@index([doctorProfileId, startedAt])
  @@index([customerPersonId, startedAt])
  @@index([countryId, status])
  @@map("encounters")
}

enum VideoSessionStatus {
  CREATED
  READY
  DOCTOR_JOINED
  CUSTOMER_JOINED
  IN_PROGRESS
  ENDED
  FAILED
  EXPIRED
}

enum VideoParticipantRole {
  DOCTOR
  CUSTOMER
}

model VideoSession {
  id                String             @id @db.Uuid
  appointmentId     String              @unique @map("appointment_id") @db.Uuid
  encounterId       String?            @map("encounter_id") @db.Uuid
  countryId         String              @map("country_id") @db.Uuid
  doctorProfileId   String              @map("doctor_profile_id") @db.Uuid
  customerPersonId  String              @map("customer_person_id") @db.Uuid
  provider          String
  providerRoomId    String              @map("provider_room_id")
  status             VideoSessionStatus @default(CREATED)
  recordingEnabled  Boolean             @default(false) @map("recording_enabled")
  doctorJoinedAt    DateTime?          @map("doctor_joined_at") @db.Timestamptz
  customerJoinedAt  DateTime?          @map("customer_joined_at") @db.Timestamptz
  startedAt         DateTime?          @map("started_at") @db.Timestamptz
  endedAt           DateTime?          @map("ended_at") @db.Timestamptz
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz
  failureCategory   String?           @map("failure_category")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  appointment       Appointment          @relation(fields: [appointmentId], references: [id])
  encounter         Encounter?         @relation(fields: [encounterId], references: [id])
  country           Country             @relation(fields: [countryId], references: [id])
  doctorProfile     DoctorProfile        @relation(fields: [doctorProfileId], references: [id])
  customer          Person              @relation(fields: [customerPersonId], references: [id])
  joinAudits        VideoJoinAudit[]
