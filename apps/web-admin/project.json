{
  "name": "web-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-admin",
  "projectType": "application",
  "tags": ["type:app", "scope:admin"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev --port 3001",
        "cwd": "apps/web-admin"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/web-admin",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/web-admin/tsconfig.json"
      }
    }
  }
}
