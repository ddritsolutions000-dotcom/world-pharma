enum AffiliateReferralCodeStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum AffiliateLinkStatus {
  ACTIVE
  INACTIVE
}

/// R12-D affiliate referral codes (country-scoped, org-owned).
model AffiliateReferralCode {
  id                String                      @id @db.Uuid
  organizationId    String                      @map("organization_id") @db.Uuid
  countryId         String                      @map("country_id") @db.Uuid
  partnerId         String?                     @map("partner_id") @db.Uuid
  code              String
  status            AffiliateReferralCodeStatus @default(DRAFT)
  version           Int                         @default(1)
  expiresAt         DateTime?                   @map("expires_at") @db.Timestamptz
  createdByPersonId String?                     @map("created_by_person_id") @db.Uuid
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  country      Country      @relation(fields: [countryId], references: [id])
  partner      Partner?     @relation(fields: [partnerId], references: [id])
  createdBy    Person?      @relation("AffiliateReferralCodeCreator", fields: [createdByPersonId], references: [id])
  links        AffiliateLink[]
  clicks       AffiliateClick[]

  @@unique([countryId, code])
  @@index([organizationId, countryId, status])
