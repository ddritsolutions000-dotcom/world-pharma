  processedAt      DateTime? @map("processed_at") @db.Timestamptz
  gateway          PaymentGateway @relation(fields: [gatewayId], references: [id])

  @@unique([gatewayId, providerEventId])
  @@index([createdAt])
  @@map("payment_webhook_events")
}

model PaymentReconciliation {
  id            String                 @id @db.Uuid
  intentId      String?                @map("intent_id") @db.Uuid
  status        ReconciliationStatus  @default(INVESTIGATE)
  breakType     String                 @map("break_type")
  detail        String
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, createdAt])
  @@map("payment_reconciliations")
}

model PaymentFxSnapshot {
  id            String   @id @db.Uuid
  baseCurrency  String    @map("base_currency") @db.Char(3)
  quoteCurrency String    @map("quote_currency") @db.Char(3)
  rateMinor     BigInt    @map("rate_minor")
  source        String    @default("mock")
  quotedAt      DateTime  @default(now()) @map("quoted_at") @db.Timestamptz
  intents       PaymentIntent[]

  @@map("payment_fx_snapshots")
