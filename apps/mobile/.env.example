# Copy to .env.local (gitignored). Never commit secrets or a production API URL.

# local | sandbox | production
# Do not set production for development devices. This sprint uses local/sandbox only.
EXPO_PUBLIC_APP_ENV=local

# Physical Android device on the same Wi-Fi as the API:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000
#
# Android emulator (host loopback):
# EXPO_PUBLIC_ANDROID_EMULATOR=true
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
#
# iOS simulator (loopback is reachable):
# EXPO_PUBLIC_ALLOW_LOOPBACK=true
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
#
# Optional: pin LAN IP for `pnpm start:lan` without hardcoding in app source.
# EXPO_PUBLIC_LAN_IP=192.168.1.10
