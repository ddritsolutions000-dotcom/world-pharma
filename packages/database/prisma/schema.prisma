  currency           String                        @db.Char(3)
  classification     SettlementMatchClassification?
  status             SettlementImportRecordStatus  @default(STAGED)
  journalSourceKey   String?                       @unique @map("journal_source_key")
  financeReconId     String?                       @map("finance_recon_id") @db.Uuid
  errorDetail        String?                       @map("error_detail")
  processedAt        DateTime?                     @map("processed_at") @db.Timestamptz
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  batch              SettlementImportBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  country            Country                       @relation(fields: [countryId], references: [id])

  @@unique([batchId, externalRecordRef])
