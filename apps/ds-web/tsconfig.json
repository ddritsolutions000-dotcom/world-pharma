{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": [
      "react",
      "react-dom",
      "node"
    ],
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@world-pharma/ui-kit": [
        "../../packages/ui-kit/src/index.ts"
      ],
      "@world-pharma/ui-kit/web": [
        "../../packages/ui-kit/src/web/index.ts"
      ],
      "@world-pharma/ui-kit/tokens": [
        "../../packages/ui-kit/src/tokens/index.ts"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
