// Transactional outbox + consumer inbox (blueprint 22). Source of truth is PostgreSQL.
// Redis/BullMQ is a delivery buffer only.

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTERED
}

model OutboxEvent {
  id              String       @id @db.Uuid
  type            String
  schemaVersion   Int          @default(1) @map("schema_version")
  aggregateType   String        @map("aggregate_type")
  aggregateId     String        @map("aggregate_id") @db.Uuid
  producer        String
  countryId       String?       @map("country_id") @db.Uuid
  regionId        String?       @map("region_id") @db.Uuid
  legalEntityId   String?       @map("legal_entity_id") @db.Uuid
  organizationId  String?       @map("organization_id") @db.Uuid
  payload         Json
  correlationId   String?       @map("correlation_id") @db.Uuid
  causationId     String?       @map("causation_id") @db.Uuid
  actorId         String?        @map("actor_id") @db.Uuid
  occurrenceKey   String        @map("occurrence_key")
  status          OutboxStatus @default(PENDING)
  availableAt     DateTime     @default(now()) @map("available_at") @db.Timestamptz
  publishedAt     DateTime?    @map("published_at") @db.Timestamptz
  failedAt        DateTime?    @map("failed_at") @db.Timestamptz
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz
  attempts        Int          @default(0)
  lastError       String?      @map("last_error")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([aggregateId, type, occurrenceKey])
  @@index([status, availableAt])
  @@index([createdAt])
  region          OperatingRegion? @relation(fields: [regionId], references: [id])
  legalEntity     LegalEntity?     @relation(fields: [legalEntityId], references: [id])

  @@index([type, createdAt])
  @@index([regionId, createdAt])
  @@index([legalEntityId, createdAt])
  @@map("outbox_events")
}

model InboxReceipt {
  consumerName String   @map("consumer_name")
  eventId       String   @map("event_id") @db.Uuid
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumerName, eventId])
  @@map("inbox_receipts")
}

