# Copy to .env.local (gitignored). Never commit secrets or a production API URL.
#
# Satellite Expo apps use @world-pharma/shell-core apiBaseUrl():
# EXPO_PUBLIC_API_BASE_URL || NEXT_PUBLIC_API_BASE_URL || http://127.0.0.1:4000
#
# Physical devices cannot reach 127.0.0.1 on the host machine.
# Set a LAN URL while the API listens on 0.0.0.0:4000 (sandbox/local only).

EXPO_PUBLIC_APP_ENV=local

# Physical device / Expo Go on same Wi-Fi:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000
#
# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
#
# iOS Simulator (macOS only):
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
