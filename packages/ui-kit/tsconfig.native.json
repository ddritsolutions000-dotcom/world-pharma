{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/packages/ui-kit-native",
    "jsx": "react-jsx",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": [],
    "noEmit": true
  },
  "include": ["src/tokens/**/*.ts", "src/native/**/*.ts", "src/native/**/*.tsx", "src/native/**/*.d.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
