  labBookingId       String             @unique @map("lab_booking_id") @db.Uuid
  labOrgId           String             @map("lab_org_id") @db.Uuid
  countryId          String             @map("country_id") @db.Uuid
  status             LabSampleCocStatus @default(ASSIGNED)
