  session CareNavigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actor   Person                @relation(fields: [actorPersonId], references: [id])

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, createdAt(sort: Desc)])
  @@map("care_nav_overrides")
}

model CareNavAudit {
  id            String   @id @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  actorPersonId String?  @map("actor_person_id") @db.Uuid
  action        String
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  session CareNavigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actor   Person?               @relation(fields: [actorPersonId], references: [id])

  @@index([sessionId, createdAt])
  @@map("care_nav_audits")
}

/// R7-F: physical hard-copy report delivery request (parcel metadata only).
