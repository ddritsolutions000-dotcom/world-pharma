enum CareNavSessionStatus {
  DRAFT
  INTAKE
  TRIAGED
  MATCHED
  COMPLETED
  TERMINATED
}

enum CareUrgencyLevel {
  ROUTINE
  SOON
  URGENT
  EMERGENT
}

/// R10-A: care navigation intake session (not a clinical artifact).
model CareNavigationSession {
  id                    String               @id @db.Uuid
  personId              String               @map("person_id") @db.Uuid
  countryId             String               @map("country_id") @db.Uuid
  status                CareNavSessionStatus @default(DRAFT)
  chiefComplaintSummary String?              @map("chief_complaint_summary")
  urgency               CareUrgencyLevel?
  specialtyCode         String?              @map("specialty_code")
  redFlag               Boolean              @default(false) @map("red_flag")
  expiresAt             DateTime             @map("expires_at") @db.Timestamptz
  completedAt           DateTime?            @map("completed_at") @db.Timestamptz
  terminatedAt          DateTime?            @map("terminated_at") @db.Timestamptz
  matchedAt             DateTime?            @map("matched_at") @db.Timestamptz
  matchSetVersion       Int                  @default(1) @map("match_set_version")
  appointmentId         String?              @unique @map("appointment_id") @db.Uuid
  sandbox               Boolean              @default(true)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  person       Person                        @relation(fields: [personId], references: [id])
  country      Country                       @relation(fields: [countryId], references: [id])
  appointment  Appointment?                  @relation(fields: [appointmentId], references: [id])
  answers      CareNavigationSessionAnswer[]
  assessments  CareTriageAssessment[]
  matches      CareMatchRecommendation[]
  audits       CareNavAudit[]
  overrides    CareNavOverride[]

  @@index([personId, createdAt(sort: Desc)])
  @@index([countryId, status])
  @@index([appointmentId])
  @@map("care_navigation_sessions")
}

model CareNavigationSessionAnswer {
  id          String   @id @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  questionKey String   @map("question_key")
  answerText  String   @map("answer_text")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  session CareNavigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionKey])
  @@index([sessionId])
  @@map("care_navigation_session_answers")
}

model CareTriageAssessment {
  id                   String           @id @db.Uuid
  sessionId            String           @map("session_id") @db.Uuid
  rulesVersion         String           @map("rules_version")
  urgency              CareUrgencyLevel
  redFlag              Boolean          @map("red_flag")
  specialtyCodes       String[]         @map("specialty_codes")
  explanationKey       String           @map("explanation_key")
  emergencyGuidanceKey String?          @map("emergency_guidance_key")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz

  session CareNavigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("care_triage_assessments")
}

/// Reserved for R10-C matching; schema present in R10-A, population deferred.
model CareMatchRecommendation {
  id              String   @id @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  doctorProfileId String?  @map("doctor_profile_id") @db.Uuid
  rank            Int
  explanationKey  String   @map("explanation_key")
  setVersion      Int      @default(1) @map("set_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  session CareNavigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, setVersion])
  @@map("care_match_recommendations")
}

/// R10-D: append-only clinician/admin governance override log.
model CareNavOverride {
  id              String   @id @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  actorPersonId   String   @map("actor_person_id") @db.Uuid
  action          String
  reason          String
  priorState      Json     @map("prior_state")
  newState        Json     @map("new_state")
  idempotencyKey  String?  @map("idempotency_key")
