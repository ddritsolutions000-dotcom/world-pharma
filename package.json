{
  "name": "world-pharma",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10.15.1"
  },
  "scripts": {
    "dev": "nx serve api",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema packages/database/prisma/schema.prisma",
    "ci:audit": "node scripts/ci/audit.mjs",
    "ci:migrations": "node scripts/ci/check-migrations.mjs",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "postinstall": "prisma generate --schema packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.14.0",
    "bullmq": "^6.2.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.11",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@swc/helpers": "~0.5.18",
    "@types/express": "^5.0.3",
    "@types/jest": "~30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "23.1.1",
    "prettier": "~3.6.2",
    "prisma": "^6.14.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
