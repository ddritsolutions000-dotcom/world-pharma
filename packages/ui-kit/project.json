{
  "name": "ui-kit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui-kit/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:ui"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/ui-kit/tsconfig.json && tsc --noEmit -p packages/ui-kit/tsconfig.native.json"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
