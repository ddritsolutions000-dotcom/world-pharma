}

model SettlementImportWorkerRun {
  id                    String                         @id @db.Uuid
  scheduleId            String?                        @map("schedule_id") @db.Uuid
  countryId             String                         @map("country_id") @db.Uuid
  providerCode          String                         @map("provider_code")
  environment           String                         @default("sandbox")
  externalBatchRef      String                         @map("external_batch_ref")
  idempotencyKey        String                         @unique @map("idempotency_key")
  status                SettlementImportWorkerRunStatus @default(PENDING)
  retryCount            Int                            @default(0) @map("retry_count")
  maxRetries            Int                            @default(3) @map("max_retries")
  failureClassification String?                        @map("failure_classification")
  lastErrorCode         String?                        @map("last_error_code")
  errorDetail           String?                        @map("error_detail")
  startedAt             DateTime?                      @map("started_at") @db.Timestamptz
  completedAt           DateTime?                      @map("completed_at") @db.Timestamptz
  nextRetryAt           DateTime?                      @map("next_retry_at") @db.Timestamptz
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                       @updatedAt @map("updated_at") @db.Timestamptz
  schedule              SettlementImportSchedule?      @relation(fields: [scheduleId], references: [id])
  country               Country                        @relation(fields: [countryId], references: [id])
  batches               SettlementImportBatch[]

  @@index([status, nextRetryAt])
  @@index([countryId, createdAt])
  @@map("settlement_import_worker_runs")
}

model SettlementImportRecord {
  id                 String                       @id @db.Uuid
  batchId            String                        @map("batch_id") @db.Uuid
