  item        CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, locale])
  @@map("catalog_item_i18n")
}

model CatalogAsset {
  id          String           @id @db.Uuid
  itemId      String            @map("item_id") @db.Uuid
