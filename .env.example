# Copy to .env for local development. Never commit .env.

NODE_ENV=development
# Auto-seed demo medicines, doctor, lab & delivery data on API boot (development only).
DEV_SANDBOX_SEED=true
# Next.js and many local tools use 3000; the API listens on 4000.
PORT=4000

# PostgreSQL 16 (docker compose)
POSTGRES_USER=worldpharma
POSTGRES_PASSWORD=worldpharma
POSTGRES_DB=worldpharma
# If Windows PostgreSQL already uses 5432/5433, set POSTGRES_PORT=55432 and match DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://worldpharma:worldpharma@127.0.0.1:5432/worldpharma?schema=public

# Redis 7 via Docker Compose (required for BullMQ).
# Inside Compose network: REDIS_URL=redis://redis:6379
# Host-run API: map REDIS_PORT (default 56379) so it does not collide with a host Redis 3.x on 6379.
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_MS=1000
OUTBOX_WORKER_CONCURRENCY=4
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003,http://localhost:3004,http://127.0.0.1:3004,http://localhost:3005,http://127.0.0.1:3005,http://localhost:3006,http://127.0.0.1:3006,http://localhost:3007,http://127.0.0.1:3007,http://localhost:3008,http://127.0.0.1:3008,http://localhost:3009,http://127.0.0.1:3009,http://localhost:3010,http://127.0.0.1:3010,http://localhost:3011,http://127.0.0.1:3011,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8091,http://127.0.0.1:8091,http://localhost:8092,http://127.0.0.1:8092,http://localhost:19011,http://127.0.0.1:19011,http://localhost:19012,http://127.0.0.1:19012,http://localhost:19013,http://127.0.0.1:19013,http://localhost:19014,http://127.0.0.1:19014,http://localhost:19015,http://127.0.0.1:19015,http://localhost:19016,http://127.0.0.1:19016,http://localhost:19017,http://127.0.0.1:19017,http://vendor.demo.com:3004,http://vendor.demo.com
# Required in staging/production — protects GET /metrics
# METRICS_TOKEN=
HTTP_JSON_LIMIT=100kb

# Mobile (Expo) — set at Expo start/build time, never commit a developer LAN IP into app source.
# EXPO_PUBLIC_APP_ENV=local
# Physical device: EXPO_PUBLIC_API_BASE_URL=http://<LAN-IPv4>:4000
# Android emulator: EXPO_PUBLIC_ANDROID_EMULATOR=true and http://10.0.2.2:4000
# Do not set EXPO_PUBLIC_APP_ENV=production for device testing.
# See apps/mobile/.env.example and docs/ops/MOBILE_REAL_DEVICE_RUNTIME_AND_BUILD_VALIDATION.md

# Identity (local only — never commit real secrets)
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32ch
OTP_PEPPER=test-otp-pepper-must-be-32-chars-minx
JWT_ISSUER=world-pharma
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1209600
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_LENGTH=6
# Local only. Forbidden in production.
AUTH_DEV_REVEAL_OTP=true
# Local only. When false (default), login skips MFA in development/test. Ignored in staging/production.
AUTH_MFA_ENABLED=false

# Optional LiveKit sandbox (non-production). Leave unset to use mock video provider in local dev.
# VIDEO_PROVIDER=mock
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Payment — sandbox only until R14-A human gates (0/7) are evidenced and live enablement is authorized.
# DEV gate placeholders may exist in r14a_human_gates; they are NOT Book-263 evidence and cannot enable live.
# PAYMENT_ENVIRONMENT=sandbox
# PAYMENT_LIVE_ENABLED=false
# PAYMENT_PRODUCTION_COUNTRIES=  # comma-separated ISO2; empty until human gates close
# PAYMENT_RISK_ADAPTER=  # production only; allowlist/sandbox rejected in live mode
# PAYMENT_MOCK_WEBHOOK_SECRET=  # sandbox webhook HMAC only; never commit production values
# Future live PSP secret references (paths/keys only — never commit secret values):
# PAYMENT_GATEWAY_{GATEWAY_CODE}_SECRET_REF=vault:prod/payments/{psp}/credential

# Partner / affiliate / doctor / lab / delivery PAYOUT
# TODAY: sandbox MockPayoutAdapter only — no gateway required.
# LATER: plug RazorpayX when you have an account (software rail already complete).
# PAYOUT_PROVIDER=MOCK
# --- when ready for Razorpay (leave commented until then) ---
# PAYOUT_PROVIDER=RAZORPAYX
# RAZORPAYX_KEY_ID=
# RAZORPAYX_KEY_SECRET=
# RAZORPAYX_ACCOUNT_NUMBER=
# RAZORPAYX_WEBHOOK_SECRET=
# PAYOUT_BENEFICIARY_ENCRYPTION_KEY=   # set anytime to encrypt bank/UPI for future live use
# PAYOUT_LEGAL_ATTESTED=false
# PAYOUT_KYC_ATTESTED=false
# PAYOUT_DUAL_CONTROL_ATTESTED=false
# PROVIDER_APPROVED_AFFILIATE_PAYOUT=false
# PAYOUT_LIVE_ENABLED=false
# Webhook (after Razorpay): POST /api/v1/finance/payouts/webhook
# Admin readiness: GET /api/v1/admin/control-plane/partner-payout-software-readiness

# Communications / OTP — sandbox only until OTP_PROVIDER + sender approvals are genuine.
# COMMUNICATION_ENVIRONMENT=sandbox
# OTP_LIVE_ENABLED=false
# COMMUNICATION_LIVE_ENABLED=false
# Never set OTP_LIVE_ENABLED=true without verified OTP_PROVIDER ProductionDependency + sender config ref.

# Logistics / last-mile — sandbox MockCarrierAdapter only until a genuine CARRIER ProductionDependency is live.
# LOGISTICS_ENVIRONMENT=sandbox
# CARRIER_ENVIRONMENT=sandbox
# CARRIER_LIVE_ENABLED=false
# LOGISTICS_LIVE_ENABLED=false
# CARRIER_MOCK_WEBHOOK_SECRET=  # sandbox HMAC only; never commit production values
# Never set CARRIER_LIVE_ENABLED=true without a verified non-mock CARRIER dependency, service coverage, and operational approval.

# Healthcare network — sandbox doctor/lab/imaging workflows by default.
# Live eRx / video / PACS / DICOM / HL7 / FHIR remain EXTERNAL_GATED until real providers are configured.
# HEALTHCARE_ENVIRONMENT=sandbox
# CLINICAL_ENVIRONMENT=sandbox
# HEALTHCARE_LIVE_ENABLED=false
# Never set HEALTHCARE_LIVE_ENABLED=true without verified ProductionDependency rows and clinical approvals.

# Infrastructure / storage / scanning — sandbox local disk + noop scanner by default.
# Production cloud backends are EXTERNAL_GATED until operators connect real providers.
# INFRASTRUCTURE_ENVIRONMENT=sandbox
# OBJECT_STORAGE_ENVIRONMENT=sandbox
# OBJECT_STORAGE_LIVE_ENABLED=false
# OBJECT_STORAGE_BACKEND=LOCAL
# OBJECT_STORAGE_BUCKET_REF=
# OBJECT_STORAGE_SECRET_REF=
# FILE_SCANNING_ENVIRONMENT=sandbox
# FILE_SCANNING_LIVE_ENABLED=false
# MALWARE_SCANNER=noop
# MALWARE_SCANNER_PROVIDER=
# MALWARE_SCANNER_ENDPOINT_REF=
# SECRET_MANAGER_REF=
# KMS_KEY_REF=
# BACKUP_DIR=
# Never commit secret values. Use references only.

APP_VERSION=0.0.0
GIT_SHA=local
BUILD_TIME=
